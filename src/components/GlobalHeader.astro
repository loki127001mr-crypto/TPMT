---
export interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home', page: 'home' },
  { href: '/about-us', label: 'About Us', page: 'about-us' },
  { href: '/services', label: 'Services & D3 Solutions', page: 'services' },
  { href: '/capabilities', label: 'Capabilities & Portfolio', page: 'capabilities' },
  { href: '/contact', label: 'Contact Us', page: 'contact' },
];
---

<header class="fixed top-0 w-full z-50 shadow-[0_1px_8px_rgba(0,0,0,0.06)]">
  <!-- Top Info Bar -->
  <div class="bg-navy-deep text-slate-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 h-9 flex items-center justify-between font-data-mono text-body-sm">
      <div class="flex items-center gap-space-lg">
        <a class="flex items-center gap-space-xs text-slate-400 hover:text-electric-cyan transition-colors" href="tel:+919176729970">
          <span class="material-symbols-outlined text-[14px] text-precision-teal">call</span>
          <span>+91 9176729970</span>
        </a>
        <span class="text-slate-700 hidden sm:inline">|</span>
        <a class="hidden sm:flex items-center gap-space-xs text-slate-400 hover:text-electric-cyan transition-colors" href="mailto:Tripowermouldtec@gmail.com">
          <span class="material-symbols-outlined text-[14px] text-precision-teal">mail</span>
          <span>Tripowermouldtec@gmail.com</span>
        </a>
      </div>
      <div class="flex items-center gap-space-md">
        <span class="text-slate-400 font-label-caps text-label-caps">CHENNAI, INDIA</span>
      </div>
    </div>
  </div>
  <!-- Main Navigation -->
  <div class="bg-navy-surface/95 backdrop-blur-xl border-b border-navy-card">
    <div class="h-20 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-space-md">
        <img alt="Tripower Mould Tech Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCAfZJ_HTjZ4p5eA9ZsnDwGRijYEfTWuD4YDBuWB6gReeeRBze11exhulSxBX4sqFEBy94X6gNhIPW1dQG1lopE1j43e_Nxuk5TLkdEFNBK31RJGq4PvywKBLtaMTynn1tS-EfyG04kS-PGWFT3yj2mf2HGApk2TGIH75IUXyEtk7KWdS9t9dcvErG74Nc19GcLg7h-gzuCaHyI8t0QHawOWffb2fBlKhjJGQFX3QNy" />
        <div class="flex flex-col">
          <span class="font-headline-sm text-headline-sm text-white tracking-tight leading-tight">TRIPOWER</span>
          <span class="font-label-caps text-label-caps text-precision-teal leading-none">MOLD TECH • D3 SOLUTIONS</span>
        </div>
      </a>
      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-space-xl h-20" data-active-classes="text-electric-cyan border-b-2 border-electric-cyan font-semibold">
        {navLinks.map((link) => (
          <a
            class={currentPage === link.page
              ? 'transition-colors py-2 text-electric-cyan border-b-2 border-electric-cyan font-semibold'
              : 'text-slate-400 hover:text-white transition-colors py-2 font-body-md text-body-md'}
            href={link.href}
            aria-current={currentPage === link.page ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
      <!-- Right Actions -->
      <div class="flex items-center gap-space-md">
        <a class="hidden sm:inline-flex items-center justify-center gap-space-xs px-space-md py-space-sm bg-precision-teal hover:bg-electric-cyan text-primary font-headline-sm text-body-sm font-semibold rounded shadow transition-colors" href="/rfq">
          <span class="material-symbols-outlined text-[16px]">request_quote</span>
          <span>RFQ Portal</span>
        </a>
      </div>
    </div>
  </div>
</header>
