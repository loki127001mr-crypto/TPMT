---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Services & D3 Solutions | Tripower Mold Tech" description="End-to-end tooling services: Design, Development, Delivery. Precision Plastic Injection Molds, Insert & Multi-Cavity Tooling, D3 CAD/CAM/CAE Engineering." currentPage="services">
<div class="flex flex-col w-full">
<!-- SECTION 1: HEADER & EDITORIAL HERO -->
<section class="relative w-full bg-navy-deep text-slate-100 overflow-hidden py-space-3xl px-6 lg:px-12">
<!-- Ambient geometric background accents -->
<div class="absolute inset-0 pointer-events-none opacity-20">
<div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-precision-teal blur-3xl"></div>
<div class="absolute bottom-0 left-1/4 w-80 h-80 rounded-full bg-machined-gold blur-3xl opacity-30"></div>
<!-- Fine engineering vector grid -->
<svg class="w-full h-full text-slate-700/40" xmlns="http://www.w3.org/2000/svg">
<defs>
<pattern height="40" id="eng-grid" patternUnits="userSpaceOnUse" width="40">
<path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="0.5"></path>
</pattern>
</defs>
<rect fill="url(#eng-grid)" height="100%" width="100%"></rect>
</svg>
</div>
<div class="relative max-w-[1680px] w-full mx-auto flex flex-col lg:flex-row items-start lg:items-center justify-between gap-space-2xl">
<div class="max-w-3xl">
<div class="inline-flex items-center gap-space-xs px-3 py-1 bg-navy-surface text-precision-teal font-label-caps text-label-caps rounded-full mb-space-md">
<span class="material-symbols-outlined text-[14px]">memory</span>
<span class="">D3 METHODOLOGY • END-TO-END TOOLING ECOSYSTEM</span>
</div>
<h1 class="font-display-hero text-display-hero text-white tracking-tight mb-space-md">
          Comprehensive One-Stop Precision Moulding &amp; Engineering Solutions
        </h1>
<p class="font-body-lg text-body-lg text-slate-400 mb-space-xl max-w-2xl leading-relaxed">
          From micro-cavity rheology analysis to high-speed Makino CNC steel machining and lifetime validation. We engineer out risk, eliminate tooling cycle bottlenecks, and ensure first-time-right repeatability.
        </p>
<div class="flex flex-wrap items-center gap-space-md">
<a class="btn-cyber-blue inline-flex items-center gap-space-xs px-space-lg py-3 rounded shadow-md transition-all" href="#d3-flow">
<span class="">Explore D3 Workflow</span>
<span class="material-symbols-outlined text-[18px]">arrow_downward</span>
</a>
<a class="btn-cyber-outline inline-flex items-center gap-space-xs px-space-lg py-3 rounded transition-all" href="#rfq-callout">
<span class="material-symbols-outlined text-[18px]">upload_file</span>
<span class="">Upload 3D CAD / STEP</span>
</a>
</div>
</div>
<!-- Quick KPI Panel -->
<div class="w-full lg:w-96 bg-navy-surface/90 backdrop-blur-md rounded-xl p-space-lg shadow-xl">
<div class="flex items-center justify-between pb-space-sm mb-space-md">
<span class="font-label-caps text-label-caps text-machined-gold">SYSTEM METRICS</span>
<span class="flex h-2 w-2 relative">
<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-precision-teal opacity-75"></span>
<span class="relative inline-flex rounded-full h-2 w-2 bg-precision-teal"></span>
</span>
</div>
<div class="space-y-space-md font-data-mono">
<div class="flex items-center justify-between">
<span class="text-slate-400 text-body-sm">Machining Tolerance:</span>
<span class="text-white font-bold">± 0.005 mm</span>
</div>
<div class="flex items-center justify-between">
<span class="text-slate-400 text-body-sm">First-Trial Fit Rate:</span>
<span class="text-precision-teal font-bold">98.4%</span>
</div>
<div class="flex items-center justify-between">
<span class="text-slate-400 text-body-sm">Average Cycle Reduction:</span>
<span class="text-machined-gold font-bold">-22.5%</span>
</div>
<div class="flex items-center justify-between">
<span class="text-slate-400 text-body-sm">Quality Target:</span>
<span class="text-white font-bold">Zero Defect Ppm</span>
</div>
</div>
<div class="mt-space-md pt-space-sm text-slate-400 font-label-caps text-label-caps flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[14px]">verified</span>
<span class="">VERIFIED PRECISION AUDITED METROLOGY</span>
</div>
</div>
</div>
</section>
<!-- SECTION 2: INTERACTIVE D3 METHODOLOGY BREAKDOWN -->
<section class="w-full bg-background py-space-3xl px-6 lg:px-12" id="d3-flow">
<div class="max-w-[1680px] w-full mx-auto">
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-2xl gap-space-md">
<div>
<span class="font-label-caps text-label-caps text-secondary font-semibold uppercase tracking-wider block mb-space-xs">
            TRIPOWER CORE ARCHITECTURE
          </span>
<h2 class="font-headline-lg text-headline-lg text-on-surface">
            The D3 Engineering Methodology
          </h2>
</div>
<p class="font-body-md text-body-md text-on-surface-variant max-w-md">
          A synchronized tripartite framework fusing digital simulation, high-velocity precision machining, and lifecycle tool commissioning under a unified accountable toolroom.
        </p>
</div>
<!-- Tab Selectors for Phase Inspection -->
<div class="flex items-center gap-space-sm p-1.5 bg-surface-container rounded-xl max-w-xl mb-space-xl overflow-x-auto" id="d3-tabs">
<button class="flex-1 py-2.5 px-space-md rounded-lg font-headline-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-all flex items-center justify-center gap-2" id="tab-btn-0" onclick="switchD3Phase(0)">
<span class="font-label-caps text-label-caps px-1.5 py-0.5 rounded bg-primary-container text-white">01</span>
<span class="">D1: Design Phase</span>
</button>
<button class="flex-1 py-2.5 px-space-md rounded-lg font-headline-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-all flex items-center justify-center gap-2" id="tab-btn-1" onclick="switchD3Phase(1)">
<span class="font-label-caps text-label-caps px-1.5 py-0.5 rounded bg-surface-variant text-on-surface">02</span>
<span class="">D2: Development</span>
</button>
<button class="flex-1 py-2.5 px-space-md rounded-lg font-headline-sm text-body-sm text-on-surface bg-surface-container-lowest shadow-sm font-semibold transition-all flex items-center justify-center gap-2" id="tab-btn-2" onclick="switchD3Phase(2)">
<span class="font-label-caps text-label-caps px-1.5 py-0.5 rounded bg-surface-variant text-on-surface">03</span>
<span class="">D3: Delivery &amp; Support</span>
</button>
</div>
<!-- D3 Interactive Container Cards -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-desktop items-stretch">
<!-- Content Panel -->
<div class="lg:col-span-7 flex flex-col justify-between bg-surface-container-lowest p-space-xl rounded-xl shadow-sm">
<div id="d3-phase-content">
<!-- Dynamically populated or switchable view: Default is 01 Design -->
<div class="inline-flex items-center gap-space-xs text-secondary font-label-caps text-label-caps mb-space-sm">
<span class="material-symbols-outlined text-[16px]">view_in_ar</span>
<span class="">PHASE 01 // FRONT-END ENGINEERING DESIGN &amp; DFM</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-space-md" id="phase-title">Streamlined Commissioning &amp; Single-Source Toolroom Support</h3>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-lg" id="phase-desc">Tooling delivery is just the starting line. Tripower provides on-site production commissioning, spare wear components, mold refurbishment, and scheduled preventive maintenance to sustain defect-free uptime for millions of cycles.</p>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md mb-space-xl" id="phase-features">
      <div class="bg-surface-container-low p-space-md rounded-lg">
        <div class="flex items-center gap-space-xs text-primary font-headline-sm text-body-sm mb-1 font-semibold">
          <span class="material-symbols-outlined text-precision-teal text-[18px]">rocket_launch</span>
          <span class="">Streamlined Commissioning</span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Plug-and-play production handover with certified mold validation report and setup parameters.</p>
      </div>
    
      <div class="bg-surface-container-low p-space-md rounded-lg">
        <div class="flex items-center gap-space-xs text-primary font-headline-sm text-body-sm mb-1 font-semibold">
          <span class="material-symbols-outlined text-precision-teal text-[18px]">fact_check</span>
          <span class="">Long-Term Operational Reliability</span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Hardened guide pins, nickel-plated wear plates, and precision slide locks for zero-drift cycling.</p>
      </div>
    
      <div class="bg-surface-container-low p-space-md rounded-lg">
        <div class="flex items-center gap-space-xs text-primary font-headline-sm text-body-sm mb-1 font-semibold">
          <span class="material-symbols-outlined text-precision-teal text-[18px]">build</span>
          <span class="">Single-Source Maintenance</span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Emergency re-tooling, cavity polishing, and modification service under one certified roof.</p>
      </div>
    
      <div class="bg-surface-container-low p-space-md rounded-lg">
        <div class="flex items-center gap-space-xs text-primary font-headline-sm text-body-sm mb-1 font-semibold">
          <span class="material-symbols-outlined text-precision-teal text-[18px]">recycling</span>
          <span class="">Sustainable Procurement</span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Scrap reduction tooling, lower runner ratios, and green tool fabrication protocols.</p>
      </div>
    </div>
</div>
<!-- Bottom Metric bar for this Phase -->
<div class="pt-space-md flex flex-wrap items-center justify-between gap-space-md text-on-surface-variant font-data-mono text-label-caps">
<span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-status-success inline-block"></span>DFM APPROVAL TURNAROUND: 48-72 HRS</span>
<span class="text-secondary font-semibold cursor-pointer hover:underline flex items-center gap-1" onclick="switchD3Phase(1)">
              Next: Development Phase <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
</span>
</div>
</div>
<!-- Visual / Spec Diagram Panel -->
<div class="lg:col-span-5 flex flex-col justify-between bg-navy-surface text-slate-100 p-space-xl rounded-xl shadow-sm relative overflow-hidden">
<div class="relative z-10">
<div class="flex items-center justify-between mb-space-md">
<span class="font-label-caps text-label-caps text-electric-cyan">TECHNICAL PROCESS MATRIX</span>
<span class="font-data-mono text-label-caps text-slate-400" id="matrix-sub">D3_PHASE_03.LIFECYCLE</span>
</div>
<!-- Inline SVG Flow Diagram -->
<div class="my-space-md bg-navy-deep/80 p-space-md rounded-lg">
<div class="font-headline-sm text-body-sm text-white font-medium mb-space-sm flex items-center justify-between">
<span class="">Cycle Time Optimization Model</span>
<span class="text-machined-gold font-data-mono text-label-caps">-32% DEFECT RISKS</span>
</div>
<svg class="w-full h-32" fill="none" viewBox="0 0 360 110" xmlns="http://www.w3.org/2000/svg">
<!-- Curve A: Traditional Tooling -->
<path d="M10,85 C90,85 140,55 240,65 C290,70 320,50 350,55" stroke="#64748B" stroke-dasharray="4 4" stroke-width="2"></path>
<!-- Curve B: Tripower D3 Optimized -->
<path d="M10,85 C70,40 160,25 240,20 C290,18 320,15 350,15" stroke="#00B4D8" stroke-width="3"></path>
<!-- Key Markers -->
<circle cx="160" cy="25" fill="#00D2FF" r="4"></circle>
<circle cx="350" cy="15" fill="#C5A059" r="4"></circle>
<!-- Baseline labels -->
<text fill="#94A3B8" font-family="JetBrains Mono" font-size="10" x="12" y="102">CAD Ingest</text>
<text fill="#00D2FF" font-family="JetBrains Mono" font-size="10" x="145" y="102">Moldflow Sim</text>
<text fill="#C5A059" font-family="JetBrains Mono" font-size="10" x="280" y="102">Validated Run</text>
</svg>
<div class="flex items-center justify-between font-label-caps text-label-caps text-slate-400 mt-2">
<span class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-slate-500 inline-block"></span> Traditional Tooling</span>
<span class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-precision-teal inline-block"></span> Tripower D3 Engineered</span>
</div>
</div>
<!-- Detailed Objective Callouts -->
<div class="space-y-space-sm font-body-sm text-body-sm text-slate-300">
<div class="flex items-start gap-space-xs">
<span class="material-symbols-outlined text-machined-gold text-[16px] mt-0.5">check_circle</span>
<span class="">First Time Right design validation avoids costly re-machining cycles.</span>
</div>
<div class="flex items-start gap-space-xs">
<span class="material-symbols-outlined text-machined-gold text-[16px] mt-0.5">check_circle</span>
<span class="">Optimized molding machine tonnage specification to protect press longevity.</span>
</div>
<div class="flex items-start gap-space-xs">
<span class="material-symbols-outlined text-machined-gold text-[16px] mt-0.5">check_circle</span>
<span class="">Reduced integration complexity through standardized DME/HASCO mold bases.</span>
</div>
</div>
</div>
<div class="relative z-10 mt-space-lg pt-space-md flex items-center justify-between bg-navy-card/60 p-space-md rounded-lg">
<span class="font-data-mono text-body-sm text-slate-300">Target Cycle Time:</span>
<span class="font-headline-sm text-body-md text-electric-cyan font-bold">≤ 18.2 Seconds</span>
</div>
</div>
</div>
</div>
</section>
<!-- SECTION 3: CORE TOOLROOM SERVICES & SPECIALIZED CAPABILITIES -->
<section class="w-full bg-surface-container-low py-space-3xl px-6 lg:px-12">
<div class="max-w-[1680px] w-full mx-auto">
<div class="max-w-3xl mb-space-2xl">
<span class="font-label-caps text-label-caps text-secondary font-semibold uppercase tracking-wider block mb-space-xs">
          MANUFACTURING PORTFOLIO
        </span>
<h2 class="font-headline-lg text-headline-lg text-on-surface mb-space-sm">
          Specialized Moulding &amp; Toolroom Capabilities
        </h2>
<p class="font-body-md text-body-md text-on-surface-variant">
          Complete high-precision production from micro core pins for medical disposables to heavy-duty die casting dies and wire overmolding tools.
        </p>
</div>
<!-- Bento Grid Layout of 5 Core Services -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter-desktop">
<!-- CARD 1: Vertical Insert Molding -->
<div class="group bg-surface-container-lowest p-space-xl rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
<div>
<div class="flex items-center justify-between mb-space-md">
<span class="font-label-caps text-label-caps text-secondary font-semibold">CAPABILITY // 01</span>
<span class="w-10 h-10 rounded-lg bg-secondary-fixed/30 text-secondary flex items-center justify-center">
<span class="material-symbols-outlined text-[20px]">precision_manufacturing</span>
</span>
</div>
<h3 class="font-headline-md text-headline-sm text-on-surface font-semibold mb-space-xs">
              Vertical Insert Molding
            </h3>
<p class="font-body-sm text-body-sm text-on-surface-variant mb-space-md leading-relaxed">
              Precision core and cavity insert technology engineered for delicate threaded brass bushings, electrical pins, and stamped micro-terminals without insert shifting or resin flash.
            </p>
<ul class="space-y-space-xs font-body-sm text-body-sm text-on-surface-variant mb-space-lg">
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">Zero-crush hydraulic core clamping</span>
</li>
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">Rotary table multi-station tool configurations</span>
</li>
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">Tolerance retention across ± 0.005mm</span>
</li>
</ul>
</div>
<div class="pt-space-md flex items-center justify-between text-on-surface-variant font-data-mono text-label-caps">
<span class="">PRESS TONNAGE: 30T – 180T</span>
<span class="material-symbols-outlined text-secondary group-hover:translate-x-1 transition-transform">arrow_forward</span>
</div>
</div>
<!-- CARD 2: Cable Overmolding & Connector Assemblies -->
<div class="group bg-surface-container-lowest p-space-xl rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
<div>
<div class="flex items-center justify-between mb-space-md">
<span class="font-label-caps text-label-caps text-secondary font-semibold">CAPABILITY // 02</span>
<span class="w-10 h-10 rounded-lg bg-secondary-fixed/30 text-secondary flex items-center justify-center">
<span class="material-symbols-outlined text-[20px]">cable</span>
</span>
</div>
<h3 class="font-headline-md text-headline-sm text-on-surface font-semibold mb-space-xs">
              Cable Overmolding &amp; Connectors
            </h3>
<p class="font-body-sm text-body-sm text-on-surface-variant mb-space-md leading-relaxed">
              Custom tooling for medical-grade patient monitoring harnesses, IP67 sealed circular connectors, automotive wiring grommets, and strain-relief cable terminations.
            </p>
<ul class="space-y-space-xs font-body-sm text-body-sm text-on-surface-variant mb-space-lg">
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">Medical PVC, TPU, Santoprene &amp; TPE resin compatibility</span>
</li>
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">Pinch-free wire shut-off tooling design</span>
</li>
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">Rigid inner pre-molds with soft-touch exterior jacket</span>
</li>
</ul>
</div>
<div class="pt-space-md flex items-center justify-between text-on-surface-variant font-data-mono text-label-caps">
<span class="">APPLICATIONS: MEDICAL &amp; AUTO</span>
<span class="material-symbols-outlined text-secondary group-hover:translate-x-1 transition-transform">arrow_forward</span>
</div>
</div>
<!-- CARD 3: High-Precision Injection Molds -->
<div class="group bg-surface-container-lowest p-space-xl rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
<div>
<div class="flex items-center justify-between mb-space-md">
<span class="font-label-caps text-label-caps text-secondary font-semibold">CAPABILITY // 03</span>
<span class="w-10 h-10 rounded-lg bg-secondary-fixed/30 text-secondary flex items-center justify-center">
<span class="material-symbols-outlined text-[20px]">layers</span>
</span>
</div>
<h3 class="font-headline-md text-headline-sm text-on-surface font-semibold mb-space-xs">
              Precision Plastic Injection Molds
            </h3>
<p class="font-body-sm text-body-sm text-on-surface-variant mb-space-md leading-relaxed">
              Multi-cavity production tooling built with hardened premium steels (Bohler, ASSAB, NAK80). Capable of multi-million cycle operational life with low maintenance frequency.
            </p>
<ul class="space-y-space-xs font-body-sm text-body-sm text-on-surface-variant mb-space-lg">
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">Hot runner systems (Yudo, Mold-Masters, Husky)</span>
</li>
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">Sub-gate, valve gate, and pinpoint gate tooling</span>
</li>
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">High-cavitation tooling (up to 32 cavities)</span>
</li>
</ul>
</div>
<div class="pt-space-md flex items-center justify-between text-on-surface-variant font-data-mono text-label-caps">
<span class="">SPI CLASS: 101 &amp; 102 TOOLING</span>
<span class="material-symbols-outlined text-secondary group-hover:translate-x-1 transition-transform">arrow_forward</span>
</div>
</div>
<!-- CARD 4: Die Casting & Compression Moulding Tooling -->
<div class="group bg-surface-container-lowest p-space-xl rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
<div>
<div class="flex items-center justify-between mb-space-md">
<span class="font-label-caps text-label-caps text-secondary font-semibold">CAPABILITY // 04</span>
<span class="w-10 h-10 rounded-lg bg-secondary-fixed/30 text-secondary flex items-center justify-center">

</span>
</div>
<h3 class="font-headline-md text-headline-sm text-on-surface font-semibold mb-space-xs">
              Die Casting &amp; Compression Moulds
            </h3>
<p class="font-body-sm text-body-sm text-on-surface-variant mb-space-md leading-relaxed">
              Thermal-fatigue resistant tooling for aluminum &amp; zinc high-pressure die casting, alongside precision thermoset compression dies engineered for extreme pressure resilience.
            </p>
<ul class="space-y-space-xs font-body-sm text-body-sm text-on-surface-variant mb-space-lg">
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">H13 Premium / Dievar steel vacuum hardening</span>
</li>
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">Thermal regulation oil circuit cross-drilling</span>
</li>
<li class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-precision-teal text-[16px]">check</span>
<span class="">Complex hydraulic core pull configurations</span>
</li>
</ul>
</div>
<div class="pt-space-md flex items-center justify-between text-on-surface-variant font-data-mono text-label-caps">
<span class="">RESISTANCE: 52-54 HRC HARDENED</span>
<span class="material-symbols-outlined text-secondary group-hover:translate-x-1 transition-transform">arrow_forward</span>
</div>
</div>
<!-- CARD 5: Custom Machining & Tool Room Support -->
<div class="group bg-surface-container-lowest p-space-xl rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between lg:col-span-2">
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">
<div>
<div class="flex items-center justify-between mb-space-md">
<span class="font-label-caps text-label-caps text-secondary font-semibold">CAPABILITY // 05</span>
<span class="w-10 h-10 rounded-lg bg-secondary-fixed/30 text-secondary flex items-center justify-center">
<span class="material-symbols-outlined text-[20px]">build_circle</span>
</span>
</div>
<h3 class="font-headline-md text-headline-sm text-on-surface font-semibold mb-space-xs">
                Tool Room Machining Support &amp; Maintenance
              </h3>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                Direct single-source maintenance, quick-turn core refurbishment, engineering change management (ECO), and high-accuracy sub-contract CNC machining.
              </p>
</div>
<div>
