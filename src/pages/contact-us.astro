<span class="material-symbols-outlined text-precision-teal text-[18px]">near_me</span>
<span class="font-headline-sm text-body-md text-slate-900 font-semibold">Location &amp; Logistics Access</span>
</div>
<span class="font-data-mono text-label-caps text-slate-400">SIDCO CORRIDOR</span>
</div>
<div class="w-full h-56 rounded-lg bg-cover bg-center relative overflow-hidden shadow-sm" data-location="Thirumudivakkam, Chennai, Tamil Nadu, India" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAWPx87F3LbaDc34plgQ6Irb2U-QBpStyRFly1LG84z1Va6iymhaRIc0B7X2HyF3CsZ-z_N18vt-hxwxAq32bUkIrBPnHGWjj-uh7s_hPDohJgmFkVqO-jiIANQvArLq9qdBaKb5aPwIZanspULeNqZIo9ESCniubDMDNeGjgb8Q3D8taJWnsAL6s-YgojYbPJXOFMEmeVSjc3pb2U2AiZqbuEfYRTdpCZRT1MKEFHl')">
<div class="absolute inset-0 bg-gradient-to-t from-navy-deep/80 via-transparent to-transparent flex flex-col justify-end p-space-md">
<span class="text-white font-headline-sm text-body-md font-semibold">Tripower Mold Tech Toolroom</span>
<span class="text-precision-teal font-data-mono text-label-caps">12.9818° N, 80.0984° E • Thirumudivakkam Industrial Estate</span>
</div>
</div>
<div class="mt-space-sm text-slate-700 font-body-sm text-body-sm leading-relaxed">
            Conveniently situated 8.5 km from Chennai Outer Ring Road (ORR) and 14 km from Chennai International Airport cargo terminal, enabling rapid national freight dispatch.
          </div>
</div>
</div>
<!-- RIGHT COLUMN: Minimalist Modern RFQ & Specification Portal -->
<div class="lg:col-span-7">
<div class="bg-surface-container-lowest p-space-xl rounded-xl shadow-xl relative">
<!-- Top Decorative Precision Line -->
<div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-precision-teal via-electric-cyan to-machined-gold rounded-t-xl"></div>
<div class="flex items-center justify-between mb-space-md">
<div>
<span class="font-data-mono text-label-caps text-precision-teal uppercase tracking-wider block">RFQ PORTAL SPEC-V4</span>
<h2 class="font-headline-md text-headline-md text-slate-900 tracking-tight">Technical Quote &amp; CAD Submission</h2>
</div>
<div class="hidden sm:flex items-center gap-1.5 px-3 py-1 bg-slate-100 rounded text-slate-700 font-data-mono text-label-caps">
<span class="material-symbols-outlined text-[14px] text-precision-teal">shield_with_heart</span>
<span>256-BIT SECURE</span>
</div>
</div>
<p class="font-body-md text-body-md text-slate-700 mb-space-lg">
            Submit 2D drawings, 3D STEP/CAD geometries, or project parameters. Our toolroom engineers evaluate draft angles, shrinkage coefficients, parting lines, and provide itemized quotations.
          </p>
<form class="space-y-space-lg" id="rfq-form" onsubmit="event.preventDefault(); document.getElementById('rfq-success-modal').classList.remove('hidden');">
<!-- Row 1: Contact Details -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="contact-name">
                  FULL NAME / REPRESENTATIVE <span class="text-status-error">*</span>
</label>
<input class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all placeholder:text-slate-400 focus:bg-white shadow-sm" id="contact-name" placeholder="e.g. Arun Sundaram" required="" type="text">
</div>
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="corporate-email">
                  CORPORATE EMAIL <span class="text-status-error">*</span>
</label>
<input class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all placeholder:text-slate-400 focus:bg-white shadow-sm" id="corporate-email" placeholder="name@company.com" required="" type="email">
</div>
</div>
<!-- Row 2: Phone & Company -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="phone-number">
                  PHONE / WHATSAPP NUMBER <span class="text-status-error">*</span>
</label>
<input class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all placeholder:text-slate-400 focus:bg-white shadow-sm" id="phone-number" placeholder="+91 98765 43210" required="" type="tel">
</div>
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="company-name">
                  COMPANY / OEM ORGANIZATION <span class="text-status-error">*</span>
</label>
<input class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all placeholder:text-slate-400 focus:bg-white shadow-sm" id="company-name" placeholder="e.g. Bharat Precision Devices Pvt Ltd" required="" type="text">
</div>
</div>
<!-- Row 3: Project Classification & Volume -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="project-category">
                  APPLICATION DOMAIN / CATEGORY <span class="text-status-error">*</span>
</label>
<select class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all focus:bg-white shadow-sm" id="project-category" required="">
<option disabled="" selected="" value="">Select Industry Classification</option>
<option value="medical">Medical Device &amp; Diagnostics Tooling</option>
<option value="automotive">Automotive Tier-1 &amp; Under-Hood Parts</option>
<option value="cable">Cable Harness &amp; Overmolding Dies</option>
<option value="die-casting">Pressure Die Casting &amp; Gravity Molds</option>
<option value="consumer">Industrial Consumer Plastics</option>
<option value="other">Other High-Precision Tooling</option>
</select>
</div>
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="est-volume">
                  ESTIMATED MOLD LIFE / BATCH SIZE
                </label>
<select class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all focus:bg-white shadow-sm" id="est-volume">
<option value="prototype">Prototype &amp; Bridge Tooling (&lt; 10k shots)</option>
<option value="mid-production">Production Mold (100k - 500k shots)</option>
<option value="high-volume">Hardened Multi-Cavity (&gt; 1M shots)</option>
<option value="unsure">Need Engineering Guidance</option>
</select>
</div>
</div>
<!-- Row 4: Timeline Target -->
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-space-xs">
                PROJECT TIMELINE GOAL
              </label>
<div class="grid grid-cols-2 sm:grid-cols-4 gap-space-sm">
<label class="flex items-center gap-2 p-2 rounded bg-slate-50 hover:bg-slate-100 cursor-pointer shadow-sm">
<input class="accent-navy-surface" name="timeline" type="radio" value="urgent">
<span class="font-body-sm text-body-sm text-slate-900">&lt; 3 Weeks</span>
</label>
<label class="flex items-center gap-2 p-2 rounded bg-slate-50 hover:bg-slate-100 cursor-pointer shadow-sm">
<input checked="" class="accent-navy-surface" name="timeline" type="radio" value="standard">
<span class="font-body-sm text-body-sm text-slate-900">4 - 6 Weeks</span>
</label>
<label class="flex items-center gap-2 p-2 rounded bg-slate-50 hover:bg-slate-100 cursor-pointer shadow-sm">
<input class="accent-navy-surface" name="timeline" type="radio" value="flexible">
<span class="font-body-sm text-body-sm text-slate-900">8+ Weeks</span>
</label>
<label class="flex items-center gap-2 p-2 rounded bg-slate-50 hover:bg-slate-100 cursor-pointer shadow-sm">
<input class="accent-navy-surface" name="timeline" type="radio" value="rfq-only">
<span class="font-body-sm text-body-sm text-slate-900">Costing Only</span>
</label>
</div>
</div>
<!-- CAD File Upload Dropzone -->
<div>
<div class="flex items-center justify-between mb-1">
<label class="block font-data-mono text-label-caps text-slate-700">
                  UPLOAD 3D CAD / PART DRAWINGS (.STP, .STEP, .IGES, .DWG, .PDF, .ZIP)
                </label>
<span class="font-data-mono text-label-caps text-precision-teal">MAX 100MB</span>
</div>
<div class="p-space-lg rounded-xl bg-slate-50 text-center cursor-pointer hover:bg-slate-100 transition-colors shadow-sm relative group" id="dropzone" onclick="document.getElementById('cad-file-input').click()">
<input class="hidden" id="cad-file-input" multiple="" onchange="handleFileSelect(event)" type="file">
<div class="flex flex-col items-center justify-center space-y-space-xs">
<div class="w-12 h-12 rounded-full bg-navy-surface text-precision-teal flex items-center justify-center mb-1 shadow-sm group-hover:scale-105 transition-transform">
<span class="material-symbols-outlined text-[24px]">cloud_upload</span>
</div>
<div class="font-headline-sm text-body-md text-slate-900 font-semibold">
                    Drag and drop engineering models, or <span class="text-secondary underline">browse local files</span>
</div>
<p class="font-body-sm text-body-sm text-slate-400 max-w-md">
                    Compatible formats: SolidWorks, STEP AP214/242, IGES, Parasolid (.x_t), AutoCAD DWG/DXF, and 2D inspection PDFs.
                  </p>
</div>
<div class="mt-space-sm hidden flex-wrap justify-center gap-space-xs" id="file-display"></div>
</div>
</div>
<!-- Technical Notes & Scope -->
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="project-notes">
                TECHNICAL SCOPE, RESIN TYPE &amp; TOLERANCE NOTES
              </label>
<textarea class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all placeholder:text-slate-400 focus:bg-white shadow-sm" id="project-notes" placeholder="Provide cavity count preferences (e.g. 1+1, 4-cavity), preferred tool steel (e.g. H13, NAK80, P20), resin specs (e.g. PA66-GF30, Polycarbonate), and critical tolerance zones..." rows="3"></textarea>
</div>
<!-- NDA Agreement & Consent Check -->
<div class="space-y-space-xs pt-space-xs">
<label class="flex items-start gap-space-sm cursor-pointer">
<input checked="" class="mt-1 accent-navy-surface" required="" type="checkbox">
<span class="font-body-sm text-body-sm text-slate-700">
                  I request mutual Non-Disclosure Protection (NDA). Tripower Mold Tech adheres to strict industrial IP governance for all submitted CAD models.
                </span>
</label>
