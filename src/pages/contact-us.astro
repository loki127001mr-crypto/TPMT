            Submit 2D drawings, 3D STEP/CAD geometries, or project parameters. Our toolroom engineers evaluate draft angles, shrinkage coefficients, parting lines, and provide itemized quotations.
          </p>
<form class="space-y-space-lg" id="rfq-form" onsubmit="event.preventDefault(); document.getElementById('rfq-success-modal').classList.remove('hidden');">
<!-- Row 1: Contact Details -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="contact-name">
                  FULL NAME / REPRESENTATIVE <span class="text-status-error">*</span>
</label>
<input class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all placeholder:text-slate-400 focus:bg-white shadow-sm" id="contact-name" placeholder="e.g. Arun Sundaram" required="" type="text">
</div>
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="corporate-email">
                  CORPORATE EMAIL <span class="text-status-error">*</span>
</label>
<input class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all placeholder:text-slate-400 focus:bg-white shadow-sm" id="corporate-email" placeholder="name@company.com" required="" type="email">
</div>
</div>
<!-- Row 2: Phone & Company -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="phone-number">
                  PHONE / WHATSAPP NUMBER <span class="text-status-error">*</span>
</label>
<input class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all placeholder:text-slate-400 focus:bg-white shadow-sm" id="phone-number" placeholder="+91 98765 43210" required="" type="tel">
</div>
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="company-name">
                  COMPANY / OEM ORGANIZATION <span class="text-status-error">*</span>
</label>
<input class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all placeholder:text-slate-400 focus:bg-white shadow-sm" id="company-name" placeholder="e.g. Bharat Precision Devices Pvt Ltd" required="" type="text">
</div>
</div>
<!-- Row 3: Project Classification & Volume -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="project-category">
                  APPLICATION DOMAIN / CATEGORY <span class="text-status-error">*</span>
</label>
<select class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all focus:bg-white shadow-sm" id="project-category" required="">
<option disabled="" selected="" value="">Select Industry Classification</option>
<option value="medical">Medical Device &amp; Diagnostics Tooling</option>
<option value="automotive">Automotive Tier-1 &amp; Under-Hood Parts</option>
<option value="cable">Cable Harness &amp; Overmolding Dies</option>
<option value="die-casting">Pressure Die Casting &amp; Gravity Molds</option>
<option value="consumer">Industrial Consumer Plastics</option>
<option value="other">Other High-Precision Tooling</option>
</select>
</div>
<div>
<label class="block font-data-mono text-label-caps text-slate-700 mb-1" for="est-volume">
                  ESTIMATED MOLD LIFE / BATCH SIZE
                </label>
<select class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all focus:bg-white shadow-sm" id="est-volume">
<option value="prototype">Prototype &amp; Bridge Tooling (&lt; 10k shots)</option>
<option value="mid-production">Production Mold (100k - 500k shots)</option>
<option value="high-volume">Hardened Multi-Cavity (&gt; 1M shots)</option>
<option value="unsure">Need Engineering Guidance</option>
</select>
</div>
</div>
<!-- Row 4: Timeline Target -->
