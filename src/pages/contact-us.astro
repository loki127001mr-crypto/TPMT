              </label>
<textarea class="w-full bg-slate-50 text-slate-900 font-body-md text-body-md rounded px-space-md py-space-sm outline-none transition-all placeholder:text-slate-400 focus:bg-white shadow-sm" id="project-notes" placeholder="Provide cavity count preferences (e.g. 1+1, 4-cavity), preferred tool steel (e.g. H13, NAK80, P20), resin specs (e.g. PA66-GF30, Polycarbonate), and critical tolerance zones..." rows="3"></textarea>
</div>
<!-- NDA Agreement & Consent Check -->
<div class="space-y-space-xs pt-space-xs">
<label class="flex items-start gap-space-sm cursor-pointer">
<input checked="" class="mt-1 accent-navy-surface" required="" type="checkbox">
<span class="font-body-sm text-body-sm text-slate-700">
                  I request mutual Non-Disclosure Protection (NDA). Tripower Mold Tech adheres to strict industrial IP governance for all submitted CAD models.
                </span>
</label>
</div>
<!-- Submit Button -->
<div class="pt-space-sm">
<button class="w-full py-space-md px-space-xl bg-navy-surface hover:bg-slate-900 text-white font-headline-sm text-body-lg font-semibold rounded-lg shadow-lg flex items-center justify-center gap-space-sm transition-all duration-200" type="submit">
<span>Submit RFQ for Technical Review</span>
<span class="material-symbols-outlined text-[20px] text-precision-teal">arrow_forward</span>
</button>
<p class="text-center font-data-mono text-label-caps text-slate-400 mt-space-sm">
                AUTOMATED ACKNOWLEDGMENT • DIRECT ASSIGNMENT TO MR. E. KRISHNASAMY
              </p>
</div>
</form>
</div>
</div>

