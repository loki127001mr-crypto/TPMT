</div>
<div class="hidden sm:flex items-center gap-1.5 px-3 py-1 bg-slate-100 rounded text-slate-700 font-data-mono text-label-caps">
<span class="material-symbols-outlined text-[14px] text-precision-teal">shield_with_heart</span>
