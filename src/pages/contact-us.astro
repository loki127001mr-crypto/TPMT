<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-gutter-desktop items-start">
<!-- LEFT COLUMN: Contact Directives, Plant Info, Leadership & Map -->
<div class="lg:col-span-5 space-y-space-xl">
