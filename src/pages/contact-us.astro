<!-- Inline Script for File Handling & Drag-Drop Micro-interaction -->
<script>
    function handleFileSelect(e) {
      const files = e.target.files;
      const display = document.getElementById('file-display');
      display.innerHTML = '';
      if (files.length > 0) {
        display.classList.remove('hidden');
        Array.from(files).forEach(file => {
          const chip = document.createElement('span');
          chip.className = 'inline-flex items-center gap-1 px-2.5 py-1 bg-navy-card text-electric-cyan rounded font-data-mono text-label-caps shadow-sm';
          chip.innerHTML = '<span class="material-symbols-outlined text-[12px]">description</span>' + file.name + ' (' + (file.size / (1024*1024)).toFixed(2) + ' MB)';
          display.appendChild(chip);
        });
      }
    }

    const dropzone = document.getElementById('dropzone');
    ['dragenter', 'dragover'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.add('bg-slate-200');
      }, false);
    });
    ['dragleave', 'drop'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.remove('bg-slate-200');
      }, false);
    });
    dropzone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      const files = dt.files;
      document.getElementById('cad-file-input').files = files;
      handleFileSelect({ target: { files: files } });
    });

    document.getElementById('modal-ticket-id').innerText = Math.floor(1000 + Math.random() * 9000);
  </script>

<!-- Leaflet Map Controller & Interactivity (Zero Popups, Esri Street/Satellite/OSM, Directions Corridor) -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const mapEl = document.getElementById('toolroom-map');
    if (!mapEl || typeof L === 'undefined') return;

    const toolroomCoords = [12.9818, 80.0984];
    const initialZoom = 14;

    const map = L.map('toolroom-map', {
      center: toolroomCoords,
      zoom: initialZoom,
      zoomControl: false,
      scrollWheelZoom: false
    });

    map.on('focus', function () {
      map.scrollWheelZoom.enable();
    });

    // Street Layer: Esri World Street Map (100% Free, NO API Key, No Watermark, Clean English Labels)
    const streetLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
      attribution: 'Tiles &copy; Esri &mdash; Street Map',
      maxZoom: 19
    }).addTo(map);

    // Satellite Layer: Esri World Imagery (High-Resolution Satellite)
    const satelliteLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
      attribution: 'Tiles &copy; Esri &mdash; Earthstar Geographics',
      maxZoom: 19
    });

    // OSM Layer: OpenStreetMap Standard
    const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      subdomains: 'abc',
      maxZoom: 19
    });

    // Visual Transit Route Corridor from Outer Ring Road (ORR) to Tripower Mold Tech
    const routeCoords = [
      [12.9868, 80.0862], // ORR Highway Exit 12 (Heavy Haulage Junction)
      [12.9855, 80.0898], // SIDCO Industrial Corridor Gateway
      [12.9840, 80.0935], // Thirumudivakkam Main Road
      [12.9828, 80.0965], // Sri Jeynanthi Nagar Turn
      [12.9818, 80.0984]  // Tripower Mold Tech Toolroom
    ];

    const routePolyline = L.polyline(routeCoords, {
      color: '#00A896',
      weight: 5,
      opacity: 0.95,
      lineCap: 'round',
      lineJoin: 'round',
      dashArray: '8, 8'
    }).addTo(map);

    // ORR Waypoint Marker
    const orrIcon = L.divIcon({
      className: 'tmt-orr-pin',
      html: `
        <div style="position: relative; pointer-events: none;">
          <div style="position: absolute; top: -30px; left: -54px; width: 108px; text-align: center; background: #0b1526; color: #00E5FF; font-family: 'JetBrains Mono', monospace; font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 4px; border: 1px solid #00A896; box-shadow: 0 2px 8px rgba(0,0,0,0.5); white-space: nowrap;">
            ORR EXIT // 8.5 KM
          </div>
          <div style="width: 14px; height: 14px; border-radius: 9999px; background: #00E5FF; border: 2px solid #ffffff; box-shadow: 0 0 10px #00E5FF;"></div>
        </div>
      `,
      iconSize: [14, 14],
      iconAnchor: [7, 7]
    });
    L.marker([12.9868, 80.0862], { icon: orrIcon, interactive: false }).addTo(map);

    // Custom Precision Engineering Radar Pin (Self-contained, NO pop-ups)
    const radarIcon = L.divIcon({
      className: 'tmt-radar-pin',
      html: `
        <div style="position: relative; width: 44px; height: 44px; margin-left: -22px; margin-top: -22px; pointer-events: none;">
          <div style="position: absolute; inset: 0; border-radius: 9999px; background: rgba(0, 168, 150, 0.25); animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;"></div>
          <div style="position: absolute; inset: 6px; border-radius: 9999px; background: rgba(0, 168, 150, 0.45); animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;"></div>
          <div style="position: absolute; inset: 10px; border-radius: 9999px; background: #0b1526; border: 2px solid #00A896; box-shadow: 0 4px 14px rgba(0, 168, 150, 0.6); display: flex; align-items: center; justify-content: center;">
            <div style="width: 6px; height: 6px; border-radius: 9999px; background: #00E5FF;"></div>
          </div>
          <div style="position: absolute; top: -32px; left: 50%; transform: translateX(-50%); white-space: nowrap; padding: 3px 8px; background: rgba(11, 21, 38, 0.95); color: #ffffff; font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600; letter-spacing: 0.05em; border-radius: 4px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); border: 1px solid rgba(0, 168, 150, 0.6); display: flex; align-items: center; gap: 4px;">
            <span style="width: 6px; height: 6px; border-radius: 9999px; background: #00A896; display: inline-block;"></span>
            <span>TRIPOWER MOLD TECH</span>
          </div>
        </div>
      `,
      iconSize: [0, 0],
      iconAnchor: [0, 0]
    });

    L.marker(toolroomCoords, { icon: radarIcon, interactive: false }).addTo(map);

    // Layer Switcher Buttons
    const btnStreet = document.getElementById('map-mode-street');
    const btnSat = document.getElementById('map-mode-satellite');
    const btnOsm = document.getElementById('map-mode-osm');

    function setActiveLayer(activeLayer, activeBtn) {
      [streetLayer, satelliteLayer, osmLayer].forEach(layer => {
        if (map.hasLayer(layer)) map.removeLayer(layer);
      });
      map.addLayer(activeLayer);
      [btnStreet, btnSat, btnOsm].forEach(btn => {
        if (btn) btn.className = 'px-2.5 py-1 text-label-caps font-data-mono text-slate-300 hover:text-white rounded transition-all flex items-center gap-1 cursor-pointer';
      });
      if (activeBtn) {
        activeBtn.className = 'px-2.5 py-1 text-label-caps font-data-mono text-white bg-precision-teal/30 text-precision-teal font-semibold rounded transition-all flex items-center gap-1 cursor-pointer';
      }
    }

    if (btnStreet) btnStreet.addEventListener('click', () => setActiveLayer(streetLayer, btnStreet));
    if (btnSat) btnSat.addEventListener('click', () => setActiveLayer(satelliteLayer, btnSat));
    if (btnOsm) btnOsm.addEventListener('click', () => setActiveLayer(osmLayer, btnOsm));

    // Zoom & Recenter Controls
    const btnRecenter = document.getElementById('map-recenter-btn');
    const btnZoomIn = document.getElementById('map-zoom-in-btn');
    const btnZoomOut = document.getElementById('map-zoom-out-btn');

    if (btnRecenter) {
      btnRecenter.addEventListener('click', function () {
        map.flyToBounds(L.latLngBounds(routeCoords).pad(0.18), { duration: 1.2 });
      });
    }
    if (btnZoomIn) {
      btnZoomIn.addEventListener('click', function () {
        map.zoomIn();
      });
    }
    if (btnZoomOut) {
      btnZoomOut.addEventListener('click', function () {
        map.zoomOut();
      });
    }
  });
</script>
</BaseLayout>
