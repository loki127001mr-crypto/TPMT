              </label>
<div class="grid grid-cols-2 sm:grid-cols-4 gap-space-sm">
<label class="flex items-center gap-2 p-2 rounded bg-slate-50 hover:bg-slate-100 cursor-pointer shadow-sm">
<input class="accent-navy-surface" name="timeline" type="radio" value="urgent">
<span class="font-body-sm text-body-sm text-slate-900">&lt; 3 Weeks</span>
</label>
<label class="flex items-center gap-2 p-2 rounded bg-slate-50 hover:bg-slate-100 cursor-pointer shadow-sm">
<input checked="" class="accent-navy-surface" name="timeline" type="radio" value="standard">
<span class="font-body-sm text-body-sm text-slate-900">4 - 6 Weeks</span>
</label>
<label class="flex items-center gap-2 p-2 rounded bg-slate-50 hover:bg-slate-100 cursor-pointer shadow-sm">
<input class="accent-navy-surface" name="timeline" type="radio" value="flexible">
<span class="font-body-sm text-body-sm text-slate-900">8+ Weeks</span>
</label>
<label class="flex items-center gap-2 p-2 rounded bg-slate-50 hover:bg-slate-100 cursor-pointer shadow-sm">
<input class="accent-navy-surface" name="timeline" type="radio" value="rfq-only">
<span class="font-body-sm text-body-sm text-slate-900">Costing Only</span>
</label>
</div>
</div>
<!-- CAD File Upload Dropzone -->
<div>
<div class="flex items-center justify-between mb-1">
<label class="block font-data-mono text-label-caps text-slate-700">
                  UPLOAD 3D CAD / PART DRAWINGS (.STP, .STEP, .IGES, .DWG, .PDF, .ZIP)
                </label>
<span class="font-data-mono text-label-caps text-precision-teal">MAX 100MB</span>
</div>
<div class="p-space-lg rounded-xl bg-slate-50 text-center cursor-pointer hover:bg-slate-100 transition-colors shadow-sm relative group" id="dropzone" onclick="document.getElementById('cad-file-input').click()">
<input class="hidden" id="cad-file-input" multiple="" onchange="handleFileSelect(event)" type="file">
<div class="flex flex-col items-center justify-center space-y-space-xs">
<div class="w-12 h-12 rounded-full bg-navy-surface text-precision-teal flex items-center justify-center mb-1 shadow-sm group-hover:scale-105 transition-transform">
<span class="material-symbols-outlined text-[24px]">cloud_upload</span>
</div>
<div class="font-headline-sm text-body-md text-slate-900 font-semibold">
                    Drag and drop engineering models, or <span class="text-secondary underline">browse local files</span>
</div>
<p class="font-body-sm text-body-sm text-slate-400 max-w-md">
                    Compatible formats: SolidWorks, STEP AP214/242, IGES, Parasolid (.x_t), AutoCAD DWG/DXF, and 2D inspection PDFs.
                  </p>
</div>
<div class="mt-space-sm hidden flex-wrap justify-center gap-space-xs" id="file-display"></div>
</div>
</div>
