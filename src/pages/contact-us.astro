                </span>
</label>
</div>
<!-- Submit Button -->
<div class="pt-space-sm">
<button class="w-full py-space-md px-space-xl bg-navy-surface hover:bg-slate-900 text-white font-headline-sm text-body-lg font-semibold rounded-lg shadow-lg flex items-center justify-center gap-space-sm transition-all duration-200" type="submit">
<span>Submit RFQ for Technical Review</span>
<span class="material-symbols-outlined text-[20px] text-precision-teal">arrow_forward</span>
</button>
<p class="text-center font-data-mono text-label-caps text-slate-400 mt-space-sm">
                AUTOMATED ACKNOWLEDGMENT • DIRECT ASSIGNMENT TO MR. E. KRISHNASAMY
              </p>
</div>
</form>
</div>
</div>

