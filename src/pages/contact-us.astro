</div>
<!-- NDA Agreement & Consent Check -->
<div class="space-y-space-xs pt-space-xs">
<label class="flex items-start gap-space-sm cursor-pointer">
<input checked="" class="mt-1 accent-navy-surface" required="" type="checkbox">
<span class="font-body-sm text-body-sm text-slate-700">
