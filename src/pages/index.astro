---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tripower Mold Tech | Advanced Tooling & Precision Injection Mold Solutions" description="Operating from our 1,500 sq. ft. precision facility in Thirumudivakkam, Chennai. Equipped with Makino VMC CNC centers, Wire EDM, and full CMM metrology for sub-micron tooling in mission-critical applications." currentPage="home">
<!-- HERO SECTION -->
<section class="relative w-full bg-navy-deep text-slate-100 overflow-hidden">
<!-- Background Hero Ambient Image with Dual-Tone Shading & High-Tech Traces -->
<div class="absolute inset-0 z-0 overflow-hidden">
<div class="w-full h-full bg-cover bg-center opacity-25 filter contrast-125 saturate-50 scale-105" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCAb9IY0GXt9r7HzrZG_dbnSIz34qsIdM7yA5RGtZpVo6xGbKvkJc-roErXGj-3aBhEwV3LW64tDDuq5TvtaeqOwtUY7GpR3rMskYcvbqzK6M5JfUZkYPo0CwDk9Krtcyb17QxXnQ38vTV9NM3zGprsCZsnct_IfrkAu6ev--4y8VyLAd8NeZf32Tzbb7D25qYL5uFXvRLtI-JZyhJI93KyZiZobxSrW68lK4pU7q2p')"></div>
<!-- Double-Shading Gradient Vignettes -->
<div class="absolute inset-0 bg-gradient-to-r from-navy-deep via-navy-deep/90 to-navy-deep/60"></div>
<div class="absolute inset-0 bg-gradient-to-t from-navy-deep via-transparent to-navy-deep/80"></div>
<!-- Ambient Dual-Tone Shading Glows -->
<div class="absolute top-1/4 -left-10 w-[550px] h-[550px] bg-rich-gold/15 rounded-full blur-[140px] pointer-events-none"></div>
<div class="absolute bottom-0 right-0 w-[650px] h-[650px] bg-cyber-blue/15 rounded-full blur-[140px] pointer-events-none"></div>
<!-- High-Tech Circuit Geometry from Reference Mockup (fills right-hand widescreen space) -->
<svg class="absolute right-0 top-0 h-full w-[540px] 2xl:w-[700px] opacity-30 pointer-events-none hidden lg:block" viewBox="0 0 540 800" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M540 120 H380 L320 180 V360 L240 440 H140" stroke="#00E5FF" stroke-width="1.5" stroke-dasharray="6 4" />
<circle cx="140" cy="440" r="4" fill="#00E5FF" />
<path d="M540 220 H440 L360 300 V520 L280 600 H80" stroke="#D4AF37" stroke-width="1.5" />
<circle cx="80" cy="600" r="4" fill="#D4AF37" />
<path d="M540 500 H420 L360 560 V740" stroke="#00F2FE" stroke-width="1.2" />
<rect x="380" y="260" width="14" height="14" stroke="#D4AF37" stroke-width="1" fill="none" transform="rotate(45 387 267)" />
<rect x="310" y="480" width="12" height="12" stroke="#00E5FF" stroke-width="1" fill="none" transform="rotate(45 316 486)" />
</svg>
<!-- Left-Hand Precision Grid Geometry (balances the left widescreen space) -->
<svg class="absolute left-0 top-0 h-full w-[360px] opacity-15 pointer-events-none hidden xl:block" viewBox="0 0 360 800" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0 140 H160 L220 200 V380" stroke="#D4AF37" stroke-width="1.2" stroke-dasharray="4 4" />
<circle cx="220" cy="380" r="3" fill="#D4AF37" />
<path d="M0 460 H100 L160 520 V700" stroke="#00E5FF" stroke-width="1" />
<rect x="94" y="514" width="12" height="12" stroke="#00E5FF" stroke-width="1" fill="none" transform="rotate(45 100 520)" />
</svg>
</div>
<!-- Architectural Content Wrapper: Full Widescreen Width -->
<div class="relative z-10 w-full px-6 sm:px-8 lg:px-12 xl:px-16 2xl:px-20 py-space-2xl lg:py-space-3xl flex flex-col justify-between">
<!-- Top Eyebrow Metadata Ribbon -->
<div class="flex flex-wrap items-center gap-space-md mb-space-lg">
<span class="inline-flex items-center gap-1.5 px-3.5 py-1 bg-dark-slate/80 border border-cyber-blue/30 rounded-full text-cyber-blue font-label-caps text-label-caps tracking-wider uppercase shadow-sm">
<span class="w-2 h-2 rounded-full bg-cyber-blue animate-pulse shadow-[0_0_8px_#00E5FF]"></span>
          THIRUMUDIVAKKAM TOOLROOM • CHENNAI
        </span>
</div>
<!-- Split Hero Architecture -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-14 items-center">
<!-- Left: Core Hook -->
<div class="lg:col-span-7 xl:col-span-8 space-y-space-lg">
<h1 class="font-heading-gold text-display-hero lg:text-5xl xl:text-6xl text-white tracking-tight leading-[1.12]">
<span class="bg-gradient-to-r from-[#FFE58F] via-[#D4AF37] to-[#B8860B] bg-clip-text text-transparent drop-shadow-[0_2px_12px_rgba(212,175,55,0.25)]">
            Advanced Tooling
          </span> &amp; <br>
<span class="bg-gradient-to-r from-[#00F2FE] via-[#00E5FF] to-[#38BDF8] bg-clip-text text-transparent drop-shadow-[0_2px_14px_rgba(0,229,255,0.3)]">
            Precision Injection Mold
          </span> <span class="bg-gradient-to-r from-[#FFE58F] via-[#D4AF37] to-[#AA7C11] bg-clip-text text-transparent">Solutions.</span>
</h1>
<p class="font-body-lg text-body-lg text-soft-gray/85 max-w-3xl leading-relaxed">
            Operating from our 1,500 sq. ft. precision facility in Thirumudivakkam, Chennai. Equipped with Makino VMC CNC centers, Wire EDM, and full CMM metrology for sub-micron tooling in mission-critical medical, electronics, and automotive applications.
          </p>
<!-- Dual CTAs -->
<div class="flex flex-wrap items-center gap-space-md pt-space-sm">
<a class="inline-flex items-center gap-space-sm px-space-xl py-space-md btn-cyber-blue rounded shadow-lg transition-all duration-200" href="/rfq">
<span>Request Engineering Quote</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
<a class="inline-flex items-center gap-space-sm px-space-xl py-space-md btn-cyber-outline rounded shadow transition-all duration-200" href="/capabilities">
<span class="material-symbols-outlined text-[18px]">precision_manufacturing</span>
<span>Explore Capabilities</span>
</a>
</div>
</div>
<!-- Right: Fast Verification Micro-Telemetry -->
<div class="lg:col-span-5 xl:col-span-4 flex flex-col gap-space-md">
<div class="bg-gradient-to-b from-dark-slate/95 to-navy-surface/95 backdrop-blur-md p-space-xl rounded-xl border border-rich-gold/40 shadow-2xl space-y-space-md">
<div class="flex items-center justify-between font-label-caps text-label-caps text-rich-gold border-b border-rich-gold/20 pb-space-xs font-semibold">
<span>FACILITY TELEMETRY</span>
<span class="text-cyber-blue font-semibold flex items-center gap-1.5">
<span class="w-1.5 h-1.5 rounded-full bg-cyber-blue animate-ping"></span> ONLINE
              </span>
</div>
<div class="divide-y divide-rich-gold/15">
<div class="py-space-sm flex justify-between items-center">
<span class="font-body-sm text-body-sm text-soft-gray/80">Toolroom Footprint</span>
<span class="font-data-mono text-body-sm text-white font-semibold">1,500 SQ. FT.</span>
</div>
<div class="py-space-sm flex justify-between items-center">
<span class="font-body-sm text-body-sm text-soft-gray/80">Standard Tolerances</span>
<span class="font-data-mono text-body-sm text-cyber-blue font-bold shadow-[0_0_8px_rgba(0,229,255,0.4)]">± 0.005 mm</span>
</div>
<div class="py-space-sm flex justify-between items-center">
<span class="font-body-sm text-body-sm text-soft-gray/80">High-Speed Spindles</span>
<span class="font-data-mono text-body-sm text-white font-semibold">Makino VMC Series</span>
</div>
<div class="py-space-sm flex justify-between items-center">
<span class="font-body-sm text-body-sm text-soft-gray/80">CAD/CAM Integration</span>
<span class="font-data-mono text-body-sm text-rich-gold font-semibold">UG NX / Moldflow</span>
</div>
</div>
</div>
</div>
</div>
<!-- High-Impact Stats Matrix: Double Shaded Backdrop -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-gutter mt-space-2xl pt-space-xl bg-gradient-to-r from-dark-slate/70 via-navy-surface/80 to-dark-slate/70 backdrop-blur-md rounded-xl border border-rich-gold/25 p-space-lg shadow-xl">
<div class="flex flex-col p-space-md">
<span class="font-metric-val text-metric-val text-white font-bold">15+</span>
<span class="font-label-caps text-label-caps text-soft-gray/80 uppercase mt-1">Years Industry Leadership</span>
<span class="font-body-sm text-body-sm text-cyber-blue mt-0.5">Proven Tamil Nadu Hub</span>
</div>
<div class="flex flex-col p-space-md">
<span class="font-metric-val text-metric-val bg-gradient-to-r from-cyber-blue to-teal-300 bg-clip-text text-transparent font-bold">D3</span>
<span class="font-label-caps text-label-caps text-soft-gray/80 uppercase mt-1">Design • Dev • Delivery</span>
<span class="font-body-sm text-body-sm text-soft-gray/70 mt-0.5">End-to-End Methodology</span>
</div>
<div class="flex flex-col p-space-md">
<span class="font-metric-val text-metric-val bg-gradient-to-r from-[#FFE58F] to-[#D4AF37] bg-clip-text text-transparent font-bold">±5μm</span>
<span class="font-label-caps text-label-caps text-soft-gray/80 uppercase mt-1">Makino VMC Precision</span>
<span class="font-body-sm text-body-sm text-soft-gray/70 mt-0.5">Optical &amp; CMM Verified</span>
</div>
<div class="flex flex-col p-space-md">
<span class="font-metric-val text-metric-val text-emerald-400 font-bold">100%</span>
<span class="font-label-caps text-label-caps text-soft-gray/80 uppercase mt-1">Zero Defect &amp; On-Time</span>
<span class="font-body-sm text-body-sm text-soft-gray/70 mt-0.5">Mission-Critical SLAs</span>
</div>
</div>
</div>
</section>
<!-- D3 METHODOLOGY ENGINE -->
<section class="w-full bg-surface py-space-3xl text-on-surface">
<div class="w-full px-6 sm:px-8 lg:px-12 xl:px-16 2xl:px-20">
<!-- Section Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-2xl gap-space-md">
<div>
<div class="flex items-center gap-2 text-secondary font-label-caps text-label-caps uppercase tracking-wider mb-space-xs">
<span class="material-symbols-outlined text-[16px] text-precision-teal">account_tree</span>
            Structured Engineering Framework
          </div>
<h2 class="font-heading-gold text-headline-lg text-rich-gold">
            The D3 Execution Engine
          </h2>
</div>
<p class="font-body-md text-body-md text-slate-300 max-w-md">
          From native CAD concept to high-yield production, our unified 3-phase methodology eliminates mold rebuilds and accelerates industrialization.
        </p>
</div>
<!-- 3 Phase Workflow Cards (Gold Hairline Border from Wireframe Mockup) -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter-desktop">
<!-- Step 1: Design -->
<div class="card-tech-gold p-space-xl rounded-xl flex flex-col justify-between group">
<div>
<div class="flex items-center justify-between mb-space-lg">
<span class="font-data-mono text-label-caps px-2.5 py-1 bg-dark-slate border border-precision-teal/30 rounded text-precision-teal font-bold">
                PHASE 01
              </span>
<span class="material-symbols-outlined text-precision-teal text-[28px] group-hover:scale-110 transition-transform">architecture</span>
</div>
<h3 class="font-heading-gold text-headline-md text-rich-gold mb-space-sm">Design &amp; DFM</h3>
<p class="font-body-md text-body-md text-slate-300 mb-space-lg leading-relaxed">
              Comprehensive DFM analysis, 3D mold layout simulation, gate cooling optimization, and parting line feasibility check before steel cutting.
            </p>
</div>
<div class="space-y-space-xs font-data-mono text-body-sm pt-space-md bg-dark-slate p-space-md rounded border border-slate-700/50">
<div class="flex items-center justify-between text-slate-300">
<span>Rheology Analysis</span>
<span class="text-status-success font-semibold">PASS</span>
</div>
<div class="flex items-center justify-between text-slate-300">
<span>Shrinkage Offset</span>
<span class="text-white font-semibold">Calibrated</span>
</div>
<div class="flex items-center justify-between text-slate-300">
<span>CAD Platforms</span>
<span class="text-precision-teal font-semibold">Creo / Solidworks</span>
</div>
</div>
</div>
<!-- Step 2: Development & Testing -->
<div class="card-tech-gold p-space-xl rounded-xl flex flex-col justify-between group">
<div>
<div class="flex items-center justify-between mb-space-lg">
<span class="font-data-mono text-label-caps px-2.5 py-1 bg-dark-slate border border-machined-gold/30 rounded text-machined-gold font-bold">
                PHASE 02
              </span>
<span class="material-symbols-outlined text-machined-gold text-[28px] group-hover:scale-110 transition-transform">precision_manufacturing</span>
</div>
<h3 class="font-heading-gold text-headline-md text-rich-gold mb-space-sm">Development &amp; Testing</h3>
<p class="font-body-md text-body-md text-slate-300 mb-space-lg leading-relaxed">
              Makino VMC high-speed machining, precision EDM, tool assembly, and initial T0-T1 mold sampling runs under strict process validation.
            </p>
</div>
<div class="space-y-space-xs font-data-mono text-body-sm pt-space-md bg-dark-slate p-space-md rounded border border-slate-700/50">
<div class="flex items-center justify-between text-slate-300">
<span>EDM Spark Gap</span>
<span class="text-white font-semibold">0.015 mm</span>
</div>
<div class="flex items-center justify-between text-slate-300">
<span>Tool Steel Standard</span>
<span class="text-machined-gold font-semibold">H13 / Stavax ESR</span>
</div>
<div class="flex items-center justify-between text-slate-300">
<span>Sample Validation</span>
<span class="text-status-success font-semibold">T1 First Article</span>
</div>
</div>
</div>
<!-- Step 3: Delivery -->
<div class="card-tech-gold p-space-xl rounded-xl flex flex-col justify-between group">
<div>
<div class="flex items-center justify-between mb-space-lg">
<span class="font-data-mono text-label-caps px-2.5 py-1 bg-dark-slate border border-precision-teal/30 rounded text-precision-teal font-bold">
                PHASE 03
              </span>
<span class="material-symbols-outlined text-precision-teal text-[28px] group-hover:scale-110 transition-transform">local_shipping</span>
</div>
<h3 class="font-heading-gold text-headline-md text-rich-gold mb-space-sm">Delivery &amp; Handover</h3>
<p class="font-body-md text-body-md text-slate-300 mb-space-lg leading-relaxed">
              100% CMM dimensional inspection sign-off, full tool maintenance manual, hot-runner diagnostics, and on-site integration support.
            </p>
</div>
<div class="space-y-space-xs font-data-mono text-body-sm pt-space-md bg-dark-slate p-space-md rounded border border-slate-700/50">
<div class="flex items-center justify-between text-slate-300">
<span>Metrology Audit</span>
<span class="text-status-success font-semibold">100% CMM</span>
</div>
<div class="flex items-center justify-between text-slate-300">
<span>Spare Insert Pack</span>
<span class="text-white font-semibold">Included</span>
</div>
<div class="flex items-center justify-between text-slate-300">
<span>Tool Warranty</span>
<span class="text-precision-teal font-semibold">Up to 1M Shots</span>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- CORE SPECIALIZATION BANNER: VERTICAL INSERT & CABLE OVERMOLDING -->
<section class="w-full bg-charcoal-blue py-space-3xl text-soft-gray border-y border-rich-gold/20">
<div class="w-full px-6 sm:px-8 lg:px-12 xl:px-16 2xl:px-20">
<div class="bg-navy-surface rounded-xl border border-rich-gold/30 shadow-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-12">
<!-- Image Area with Wireframe Accent Overlay -->
<div class="lg:col-span-6 relative min-h-[380px] lg:min-h-full">
<div class="w-full h-full bg-cover bg-center min-h-[360px]" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAFk_q6Yy_AZkd4XM2fBwDzfj0Er9pI9zMmNFbjPwYaRvmWkyRSycNiZJmzpAnjuIOn9tb1-5tc8w7OCLe2rcqTUYDjc6jJeOcFyYsVXlkKW6VazrQeCihYVrO_qanFAIWCwulq48f0z8Q64_UW-UBbMO6Y_vwfQtgipoKGQ1JXoEi38GMX8kbhhhAWRxyBaNPBRRY5f5nESCWpU15iyBoE4LzHeOBUKNS-RKtFxj3R')"></div>
<div class="absolute inset-0 bg-gradient-to-t from-navy-deep/90 via-transparent to-transparent pointer-events-none"></div>
<div class="absolute bottom-4 left-4 right-4 p-space-sm bg-dark-slate/90 backdrop-blur-md rounded border border-rich-gold/30 text-white flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-cyber-blue text-[20px]">biotech</span>
<span class="font-headline-sm text-body-sm font-semibold text-soft-gray">Medical Insert Mold &amp; Overmolded Cable Harnesses</span>
</div>
<span class="font-label-caps text-label-caps bg-cyber-blue text-navy-deep px-2 py-0.5 rounded font-bold">VERIFIED</span>
</div>
</div>
<!-- Text Details -->
<div class="lg:col-span-6 p-space-xl lg:p-space-2xl flex flex-col justify-between">
<div>
<div class="inline-flex items-center gap-2 px-3 py-1 bg-dark-slate rounded-full border border-rich-gold/20 text-cyber-blue font-label-caps text-label-caps mb-space-md">
<span class="material-symbols-outlined text-[15px] text-cyber-blue">hub</span>
              HIGH PRECISION CORE SPECIALIZATION
            </div>
<h2 class="font-heading-gold text-headline-lg text-rich-gold mb-space-md leading-tight font-bold">
              Vertical Insert Molding &amp; Precision Cable Overmolding
            </h2>
<p class="font-body-md text-body-md text-soft-gray/85 mb-space-lg leading-relaxed">
              We specialize in custom tooling for vertical rotary insert molding machines. Engineered for zero pin deflection, flawless seal-off geometry, and high-integrity strain relief overmolding for medical patient monitor cables and automotive sensory harnesses.
            </p>
<!-- Specification Badges -->
<div class="grid grid-cols-2 gap-space-md mb-space-xl">
<div class="p-space-md bg-dark-slate rounded border border-rich-gold/20">
<span class="font-label-caps text-label-caps text-rich-gold block font-semibold">INSERT COMPATIBILITY</span>
<span class="font-headline-sm text-body-md font-semibold text-white">Brass, SS316, Copper &amp; PCB</span>
</div>
<div class="p-space-md bg-dark-slate rounded border border-rich-gold/20">
<span class="font-label-caps text-label-caps text-rich-gold block font-semibold">OVERMOLD RESINS</span>
<span class="font-headline-sm text-body-md font-semibold text-white">TPU, TPE, PVC, PBT, PA66</span>
</div>
<div class="p-space-md bg-dark-slate rounded border border-rich-gold/20">
<span class="font-label-caps text-label-caps text-rich-gold block font-semibold">SEAL-OFF SHUTOFF</span>
<span class="font-headline-sm text-body-md font-semibold text-cyber-blue">±0.003 mm Tolerance</span>
</div>
<div class="p-space-md bg-dark-slate rounded border border-rich-gold/20">
<span class="font-label-caps text-label-caps text-rich-gold block font-semibold">APPLICATIONS</span>
<span class="font-headline-sm text-body-md font-semibold text-white">ECG Leads, Sensor Plugs</span>
</div>
</div>
</div>
<div class="flex items-center gap-space-md flex-wrap">
<a class="btn-cyber-blue inline-flex items-center gap-space-xs px-space-lg py-space-sm font-headline-sm text-body-sm font-bold rounded shadow transition-all" href="/services">
<span>View Insert Tooling Specs</span>
<span class="material-symbols-outlined text-[16px]">arrow_forward</span>
</a>
<span class="font-data-mono text-label-caps text-rich-gold border border-rich-gold/30 px-3 py-1 rounded">CYCLE TIME OPTIMIZED</span>
</div>
</div>
</div>
</div>
</section>
<!-- CAPABILITIES SNAPSHOT MATRIX -->
<section class="w-full bg-navy-deep py-space-3xl text-soft-gray border-b border-rich-gold/20">
<div class="w-full px-6 sm:px-8 lg:px-12 xl:px-16 2xl:px-20">
<!-- Section Title -->
<div class="mb-space-2xl text-center max-w-2xl mx-auto">
<span class="font-label-caps text-label-caps text-cyber-blue uppercase tracking-widest block mb-space-xs font-semibold">
          TOOLROOM INFRASTRUCTURE
        </span>
<h2 class="font-heading-gold text-headline-lg text-rich-gold mb-space-sm font-bold">
          Precision Tooling &amp; Machining Snapshot
        </h2>
<p class="font-body-md text-body-md text-soft-gray/80">
          Advanced CNC machining centers, electrode milling, and optical grinding systems delivering aerospace &amp; medical-grade repeatability.
        </p>
</div>
<!-- 4 Pillars Interactive 3D Flip Card Gallery -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">

<!-- Card 1: High Speed CNC Milling -->
<div class="flip-card h-[430px] w-full group cursor-pointer">
  <div class="flip-card-inner">
    <!-- FRONT FACE: High-Res Image, Capability Badge, Title & Key Spec -->
    <div class="flip-card-front bg-dark-slate border border-rich-gold/30 flex flex-col justify-between shadow-xl">
      <div class="relative w-full h-52 overflow-hidden bg-navy-deep">
        <img src="/images/snapshot-cnc-milling.jpg" alt="Makino High Speed CNC Milling Machine" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-dark-slate via-dark-slate/20 to-transparent"></div>
        <div class="absolute top-3 left-3 flex items-center gap-1.5 px-2.5 py-1 bg-navy-deep/90 backdrop-blur-md border border-cyber-blue/40 rounded text-cyber-blue font-data-mono text-[11px] font-bold shadow-md">
          <span class="w-1.5 h-1.5 rounded-full bg-cyber-blue animate-pulse"></span>
          <span>CAPABILITY // 01</span>
        </div>
        <div class="absolute top-3 right-3 w-8 h-8 rounded-lg bg-navy-deep/90 backdrop-blur-md border border-rich-gold/40 flex items-center justify-center text-rich-gold shadow-md">
          <span class="material-symbols-outlined text-[18px]">precision_manufacturing</span>
        </div>
      </div>
      <div class="p-space-md flex flex-col justify-between flex-1">
        <div>
          <h3 class="font-heading-gold text-headline-sm text-rich-gold font-bold mb-1 leading-tight">High-Speed CNC Milling</h3>
          <p class="font-body-sm text-soft-gray/80 text-xs leading-relaxed line-clamp-2">
            Makino VMC high-rigidity spindles reaching 20,000 RPM for mirror cavity finishes.
          </p>
        </div>
        <div class="pt-space-xs border-t border-rich-gold/20 flex items-center justify-between font-data-mono">
          <div class="flex flex-col">
            <span class="text-[10px] text-soft-gray/60 uppercase">ACCURACY</span>
