---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Capabilities & Portfolio | Tripower Mold Tech" description="Explore our high-speed Makino CNC centers, Wire EDM, precision inspection metrology, and proven tooling project portfolio." currentPage="capabilities">
<div class="flex flex-col w-full">
<!-- Precision Technical Header Banner -->
<section class="w-full bg-navy-surface text-slate-100 py-space-xl px-6 lg:px-12 relative overflow-hidden">
<div class="absolute -right-20 -bottom-20 w-96 h-96 bg-precision-teal/5 rounded-full blur-3xl pointer-events-none"></div>
<div class="w-full flex flex-col md:flex-row md:items-end justify-between gap-space-lg relative z-10">
<div>
<div class="flex items-center gap-space-xs font-label-caps text-label-caps text-precision-teal mb-space-xs">
<span class="w-2 h-2 rounded-full bg-precision-teal animate-pulse"></span>
<span>SYSTEM // PORTFOLIO MATRIX • PRECISION REGISTERED</span>
</div>
<h1 class="font-heading-gold text-display-hero lg:text-5xl text-white tracking-tight leading-tight uppercase font-bold">Precision Tooling Portfolio &amp; Industry Applications</h1>
<p class="font-body-md text-body-md text-slate-400 mt-space-xs max-w-2xl leading-relaxed">
          High-yield micro-cavity injection molds, specialized vertical overmolding systems, and micro-metric validation tooling engineered for Tier-1 medical, automotive, and mission-critical assemblies.
        </p>
</div>
<!-- Real-Time Shopfloor Status Badge -->
<div class="bg-navy-card p-space-md rounded shadow-md shrink-0 flex items-center gap-space-md">
<div class="w-12 h-12 rounded bg-navy-surface flex items-center justify-center text-precision-teal">
<span class="material-symbols-outlined text-[28px]">precision_manufacturing</span>
</div>
<div class="flex flex-col">
<span class="font-label-caps text-label-caps text-slate-400">ACTIVE PRODUCTION TOLERANCE</span>
<span class="font-data-mono text-body-md text-electric-cyan font-bold tracking-tight">±0.003 mm MICRO-EDM</span>
<span class="font-label-caps text-[10px] text-machined-gold">METROLOGY LAB CLIMATE STABILIZED (20°C)</span>
</div>
</div>
</div>
</section>
<!-- High-Precision Metric Spec Ticker -->
<section class="w-full bg-navy-deep text-slate-100 py-space-sm px-6 lg:px-12">
<div class="w-full flex flex-wrap items-center justify-between gap-space-md font-data-mono text-label-caps text-slate-400">
<div class="flex items-center gap-space-xs text-electric-cyan">
<span class="material-symbols-outlined text-[15px] text-precision-teal">verified</span>
<span>Machining Accuracies to Micron Levels</span>
</div>
<div class="hidden md:block text-soft-gray/80">•</div>
<div class="flex items-center gap-space-xs text-slate-300">
<span class="material-symbols-outlined text-[15px] text-machined-gold">speed</span>
<span>Makino High-Speed Spindle Technology (40,000 RPM)</span>
</div>
<div class="hidden md:block text-soft-gray/80">•</div>
<div class="flex items-center gap-space-xs text-slate-300">
<span class="material-symbols-outlined text-[15px] text-precision-teal">csv</span>
<span>Optical &amp; Zeiss CMM Inspection Verification</span>
</div>
<div class="hidden lg:flex items-center gap-space-xs text-machined-gold">
<span class="material-symbols-outlined text-[15px]">format_image_left</span>
<span>100% Dimensional First Article Inspection</span>
</div>
</div>
</section>
<!-- Interactive Portfolio Explorer -->
<section class="w-full py-space-2xl px-6 lg:px-12 bg-background">
<div class="w-full flex flex-col gap-space-xl">
<!-- Section Subhead and Filter Tabs -->
<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
<div>
<span class="font-label-caps text-label-caps text-secondary font-semibold">TOOLING CATALOG &amp; PROVEN RUNS</span>
<h2 class="font-headline-md text-headline-md text-white">Verified Tooling Deployments</h2>
</div>
<!-- Filter Buttons Tabbed Control -->
<div class="flex flex-wrap items-center gap-space-xs bg-navy-card/90 p-1.5 rounded-lg border border-rich-gold/25 shadow-md" id="portfolio-filters">
<button class="filter-btn px-4 py-2 rounded-md font-rajdhani text-[14px] uppercase tracking-wider font-bold bg-cyber-blue text-navy-deep shadow-md transition-all cursor-pointer" data-filter="all">All Projects</button>
<button class="filter-btn px-4 py-2 rounded-md font-rajdhani text-[14px] uppercase tracking-wider font-semibold text-soft-gray/80 hover:text-white hover:bg-navy-surface transition-all cursor-pointer" data-filter="medical">Medical Devices</button>
<button class="filter-btn px-4 py-2 rounded-md font-rajdhani text-[14px] uppercase tracking-wider font-semibold text-soft-gray/80 hover:text-white hover:bg-navy-surface transition-all cursor-pointer" data-filter="automotive">Automotive</button>
<button class="filter-btn px-4 py-2 rounded-md font-rajdhani text-[14px] uppercase tracking-wider font-semibold text-soft-gray/80 hover:text-white hover:bg-navy-surface transition-all cursor-pointer" data-filter="overmolding">Cable Overmolding</button>
<button class="filter-btn px-4 py-2 rounded-md font-rajdhani text-[14px] uppercase tracking-wider font-semibold text-soft-gray/80 hover:text-white hover:bg-navy-surface transition-all cursor-pointer" data-filter="die-cast">Packaging &amp; Die-Cast</button>
</div>
</div>
<!-- Bento-Style Project Cards Gallery (Immediately Under Switching Tabs) -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter" id="portfolio-grid">
<!-- Project 1: Medical Micro-Molded Parts -->
<div class="portfolio-item group bg-dark-slate border border-rich-gold/25 rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between" data-category="medical">
<div class="relative h-56 bg-navy-deep overflow-hidden">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="Macro photography of ultra precise transparent and white miniature medical plastic injection molded luer lock connectors, fluidic manifold micro gears on a clean blue calibration grid mat with soft studio illumination." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDqGfsWDOvaJtDyYm07-Z5XutSZkcZeNLcaqnCe7NK81nQLjW2jVRxi9Y9bRKSOsurDIEN2xIwFEKvmHUWwqL-kPJ1gMrraO7u0IJMuHRlPs8YGLwARsAlM0ww_X8EcxFVxMiOOY9inxTv9R4bkcQcKsvNP7QC-gzGTJBGEZPQxDZHBzuDnf6w2C4x0VSB6wtFaznvigGkSx8Bg8PPj9PAS2Z4LlT1W6L3ShthZ4lcx">
<div class="absolute top-3 left-3 bg-navy-deep/80 backdrop-blur-md px-2 py-0.5 rounded text-white font-label-caps text-label-caps">
              MICRO-MOLDING
            </div>
<div class="absolute bottom-3 right-3 bg-precision-teal text-navy-deep font-data-mono text-label-caps px-2 py-0.5 rounded font-bold">
              TOLERANCE ±0.004mm
            </div>
</div>
<div class="p-space-lg flex-1 flex flex-col justify-between">
<div>
<div class="flex items-center justify-between text-slate-400 font-data-mono text-label-caps mb-1">
<span>SECTOR // CRITICAL HEALTHCARE</span>
<span class="text-precision-teal">RUN #910</span>
</div>
<h4 class="font-headline-sm text-headline-sm text-white mb-space-xs">Micro Medical Manifolds &amp; Luer Connectors</h4>
<p class="font-body-sm text-body-sm text-soft-gray/85 mb-space-md leading-relaxed">
                Single and multi-lumen connector ports with zero-parting-line mismatch for neonatal intravenous administration. Diamond-polished cores.
              </p>
</div>
<div class="pt-space-md bg-navy-deep/80 border border-rich-gold/15 p-space-md rounded">
<div class="flex justify-between items-center text-body-sm font-data-mono">
<span class="text-slate-400 font-label-caps">CAVITIES:</span>
<span class="font-bold text-white">16-Cavity Hot Runner</span>
</div>
<div class="flex justify-between items-center text-body-sm font-data-mono mt-1">
<span class="text-slate-400 font-label-caps">STEEL GRADE:</span>
<span class="font-bold text-white">Böhler M390 Microclean</span>
</div>
</div>
</div>
</div>
