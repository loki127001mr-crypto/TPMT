<script>
  // Interactive filter tabs for deployment showcase
  function initPortfolioFilters() {
    const filterButtons = document.querySelectorAll('#portfolio-filters .filter-btn');
    const portfolioItems = document.querySelectorAll('#portfolio-grid .portfolio-item');
    const featuredCard = document.getElementById('featured-benchmark');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetCategory = btn.getAttribute('data-filter');

        // Toggle active button visuals
        filterButtons.forEach(b => {
          b.classList.remove('bg-cyber-blue', 'text-navy-deep', 'font-bold', 'shadow-md');
          b.classList.add('text-soft-gray/80');
        });
        btn.classList.add('bg-cyber-blue', 'text-navy-deep', 'font-bold', 'shadow-md');
        btn.classList.remove('text-soft-gray/80');

        // Filter deployment cards
        portfolioItems.forEach(item => {
          const itemCat = item.getAttribute('data-category');
          if (targetCategory === 'all' || itemCat === targetCategory) {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        });

        // Show benchmark case study for All, Medical, and Overmolding
        if (featuredCard) {
          if (targetCategory === 'all' || targetCategory === 'medical' || targetCategory === 'overmolding') {
            featuredCard.style.display = 'grid';
          } else {
            featuredCard.style.display = 'none';
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPortfolioFilters);
  } else {
    initPortfolioFilters();
  }
</script>
