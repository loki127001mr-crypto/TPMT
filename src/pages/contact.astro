<div class="bg-dark-slate border border-rich-gold/30 text-slate-100 shadow-xl p-space-xl rounded-xl relative">
<!-- Top Decorative Precision Line -->
<div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-precision-teal via-electric-cyan to-machined-gold rounded-t-xl"></div>
<div class="flex items-center justify-between mb-space-md">
<div>
<span class="font-data-mono text-xs sm:text-sm text-precision-teal uppercase tracking-wider block font-bold">RFQ PORTAL SPEC-V4</span>
<h2 class="font-heading-gold text-2xl sm:text-3xl text-white tracking-tight font-bold">Technical Quote &amp; CAD Submission</h2>
</div>
<div class="hidden sm:flex items-center gap-1.5 px-3 py-1 bg-navy-surface border border-rich-gold/30 rounded-lg text-cyber-blue font-data-mono text-xs sm:text-sm font-bold">
<span class="material-symbols-outlined text-[16px] text-cyber-blue">shield_with_heart</span>
<span>256-BIT SECURE</span>
</div>
</div>
<p class="text-base sm:text-lg text-slate-200 mb-space-lg leading-relaxed font-normal">
            Submit 2D drawings, 3D STEP/CAD geometries, or project parameters. Our toolroom engineers evaluate draft angles, shrinkage coefficients, parting lines, and provide itemized quotations.
          </p>
<form class="space-y-space-lg" id="rfq-form" onsubmit="event.preventDefault(); document.getElementById('rfq-success-modal').classList.remove('hidden');">
<!-- Row 1: Contact Details -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div>
<label class="block font-data-mono text-xs sm:text-sm text-slate-200 mb-2 font-bold uppercase tracking-wider" for="contact-name">
                  FULL NAME / REPRESENTATIVE <span class="text-status-error">*</span>
</label>
<input class="w-full bg-navy-deep/90 border border-rich-gold/30 text-white text-base sm:text-lg rounded-lg px-4 py-3.5 outline-none transition-all placeholder:text-slate-400 focus:bg-navy-surface focus:border-cyber-blue shadow-sm" id="contact-name" placeholder="e.g. Arun Sundaram" required="" type="text">
</div>
<div>
<label class="block font-data-mono text-xs sm:text-sm text-slate-200 mb-2 font-bold uppercase tracking-wider" for="corporate-email">
                  CORPORATE EMAIL <span class="text-status-error">*</span>
</label>
<input class="w-full bg-navy-deep/90 border border-rich-gold/30 text-white text-base sm:text-lg rounded-lg px-4 py-3.5 outline-none transition-all placeholder:text-slate-400 focus:bg-navy-surface focus:border-cyber-blue shadow-sm" id="corporate-email" placeholder="name@company.com" required="" type="email">
</div>
</div>
<!-- Row 2: Phone & Company -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div>
<label class="block font-data-mono text-xs sm:text-sm text-slate-200 mb-2 font-bold uppercase tracking-wider" for="phone-number">
                  PHONE / WHATSAPP NUMBER <span class="text-status-error">*</span>
</label>
<input class="w-full bg-navy-deep/90 border border-rich-gold/30 text-white text-base sm:text-lg rounded-lg px-4 py-3.5 outline-none transition-all placeholder:text-slate-400 focus:bg-navy-surface focus:border-cyber-blue shadow-sm" id="phone-number" placeholder="+91 98765 43210" required="" type="tel">
</div>
<div>
<label class="block font-data-mono text-xs sm:text-sm text-slate-200 mb-2 font-bold uppercase tracking-wider" for="company-name">
                  COMPANY / OEM ORGANIZATION <span class="text-status-error">*</span>
</label>
<input class="w-full bg-navy-deep/90 border border-rich-gold/30 text-white text-base sm:text-lg rounded-lg px-4 py-3.5 outline-none transition-all placeholder:text-slate-400 focus:bg-navy-surface focus:border-cyber-blue shadow-sm" id="company-name" placeholder="e.g. Bharat Precision Devices Pvt Ltd" required="" type="text">
</div>
</div>
<!-- Row 3: Project Classification & Volume -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div>
<label class="block font-data-mono text-xs sm:text-sm text-slate-200 mb-2 font-bold uppercase tracking-wider" for="project-category">
                  APPLICATION DOMAIN / CATEGORY <span class="text-status-error">*</span>
</label>
<select class="w-full bg-navy-deep/90 border border-rich-gold/30 text-white text-base sm:text-lg rounded-lg px-4 py-3.5 outline-none transition-all focus:bg-navy-surface focus:border-cyber-blue shadow-sm" id="project-category" required="">
<option disabled="" selected="" value="">Select Industry Classification</option>
<option value="medical">Medical Device &amp; Diagnostics Tooling</option>
<option value="automotive">Automotive Tier-1 &amp; Under-Hood Parts</option>
<option value="cable">Cable Harness &amp; Overmolding Dies</option>
<option value="die-casting">Pressure Die Casting &amp; Gravity Molds</option>
<option value="consumer">Industrial Consumer Plastics</option>
<option value="other">Other High-Precision Tooling</option>
</select>
</div>
<div>
<label class="block font-data-mono text-xs sm:text-sm text-slate-200 mb-2 font-bold uppercase tracking-wider" for="est-volume">
                  ESTIMATED MOLD LIFE / BATCH SIZE
                </label>
<select class="w-full bg-navy-deep/90 border border-rich-gold/30 text-white text-base sm:text-lg rounded-lg px-4 py-3.5 outline-none transition-all focus:bg-navy-surface focus:border-cyber-blue shadow-sm" id="est-volume">
<option value="prototype">Prototype &amp; Bridge Tooling (&lt; 10k shots)</option>
<option value="mid-production">Production Mold (100k - 500k shots)</option>
<option value="high-volume">Hardened Multi-Cavity (&gt; 1M shots)</option>
<option value="unsure">Need Engineering Guidance</option>
</select>
</div>
</div>
<!-- Row 4: Timeline Target -->
<div>
<label class="block font-data-mono text-xs sm:text-sm text-slate-200 mb-2 font-bold uppercase tracking-wider">
                PROJECT TIMELINE GOAL
              </label>
<div class="grid grid-cols-2 sm:grid-cols-4 gap-space-sm">
<label class="flex items-center gap-2.5 p-3 rounded-lg bg-navy-deep/90 border border-rich-gold/25 hover:bg-navy-deep cursor-pointer shadow-sm">
<input class="accent-cyber-blue scale-125" name="timeline" type="radio" value="urgent">
<span class="text-sm sm:text-base text-white font-medium">&lt; 3 Weeks</span>
</label>
<label class="flex items-center gap-2.5 p-3 rounded-lg bg-navy-deep/90 border border-rich-gold/25 hover:bg-navy-deep cursor-pointer shadow-sm">
<input checked="" class="accent-cyber-blue scale-125" name="timeline" type="radio" value="standard">
<span class="text-sm sm:text-base text-white font-medium">4 - 6 Weeks</span>
</label>
<label class="flex items-center gap-2.5 p-3 rounded-lg bg-navy-deep/90 border border-rich-gold/25 hover:bg-navy-deep cursor-pointer shadow-sm">
<input class="accent-cyber-blue scale-125" name="timeline" type="radio" value="flexible">
<span class="text-sm sm:text-base text-white font-medium">8+ Weeks</span>
</label>
<label class="flex items-center gap-2.5 p-3 rounded-lg bg-navy-deep/90 border border-rich-gold/25 hover:bg-navy-deep cursor-pointer shadow-sm">
<input class="accent-cyber-blue scale-125" name="timeline" type="radio" value="rfq-only">
<span class="text-sm sm:text-base text-white font-medium">Costing Only</span>
</label>
</div>
</div>
<!-- CAD File Upload Dropzone -->
<div>
<div class="flex items-center justify-between mb-2">
<label class="block font-data-mono text-xs sm:text-sm text-slate-200 font-bold uppercase tracking-wider">
                  UPLOAD 3D CAD / PART DRAWINGS (.STP, .STEP, .IGES, .DWG, .PDF, .ZIP)
                </label>
<span class="font-data-mono text-xs sm:text-sm text-precision-teal font-bold">MAX 100MB</span>
</div>
<div class="p-space-xl rounded-xl bg-navy-deep/90 border-2 border-dashed border-rich-gold/40 text-center cursor-pointer hover:bg-navy-deep transition-colors shadow-md relative group" id="dropzone" onclick="document.getElementById('cad-file-input').click()">
<input class="hidden" id="cad-file-input" multiple="" onchange="handleFileSelect(event)" type="file">
<div class="flex flex-col items-center justify-center space-y-space-xs">
<div class="w-14 h-14 rounded-full bg-navy-surface text-precision-teal flex items-center justify-center mb-1 shadow-md group-hover:scale-110 transition-transform border border-cyber-blue/30">
<span class="material-symbols-outlined text-[28px]">cloud_upload</span>
</div>
<div class="text-base sm:text-lg text-white font-bold">
                    Drag and drop engineering models, or <span class="text-cyber-blue underline font-extrabold">browse local files</span>
</div>
<p class="text-sm sm:text-base text-slate-300 max-w-md font-normal">
                    Compatible formats: SolidWorks, STEP AP214/242, IGES, Parasolid (.x_t), AutoCAD DWG/DXF, and 2D inspection PDFs.
                  </p>
</div>
<div class="mt-space-sm hidden flex-wrap justify-center gap-space-xs" id="file-display"></div>
</div>
</div>
<!-- Technical Notes & Scope -->
<div>
<label class="block font-data-mono text-xs sm:text-sm text-slate-200 mb-2 font-bold uppercase tracking-wider" for="project-notes">
                TECHNICAL SCOPE, RESIN TYPE &amp; TOLERANCE NOTES
              </label>
<textarea class="w-full bg-navy-deep/90 border border-rich-gold/30 text-white text-base sm:text-lg rounded-lg px-4 py-3.5 outline-none transition-all placeholder:text-slate-400 focus:bg-navy-surface focus:border-cyber-blue shadow-sm" id="project-notes" placeholder="Provide cavity count preferences (e.g. 1+1, 4-cavity), preferred tool steel (e.g. H13, NAK80, P20), resin specs (e.g. PA66-GF30, Polycarbonate), and critical tolerance zones..." rows="3"></textarea>
</div>
<!-- NDA Agreement & Consent Check -->
<div class="space-y-space-xs pt-space-xs">
