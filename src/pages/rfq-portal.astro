---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="RFQ Portal | Submit Tooling RFQ - Tripower Mold Tech" description="Submit your 2D drawings or 3D CAD (.STEP / .IGS / .X_T) for preliminary DFM assessment and formal quotation within 24 hours." currentPage="rfq">
<!-- HERO SECTION -->
<section class="relative w-full bg-navy-deep text-slate-100 overflow-hidden border-b border-rich-gold/20">
<!-- Background Hero Ambient Image with Technical Scrim -->
<div class="absolute inset-0 z-0">
<div class="w-full h-full bg-cover bg-center opacity-25 filter contrast-125 saturate-50" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCAb9IY0GXt9r7HzrZG_dbnSIz34qsIdM7yA5RGtZpVo6xGbKvkJc-roErXGj-3aBhEwV3LW64tDDuq5TvtaeqOwtUY7GpR3rMskYcvbqzK6M5JfUZkYPo0CwDk9Krtcyb17QxXnQ38vTV9NM3zGprsCZsnct_IfrkAu6ev--4y8VyLAd8NeZf32Tzbb7D25qYL5uFXvRLtI-JZyhJI93KyZiZobxSrW68lK4pU7q2p')"></div>
