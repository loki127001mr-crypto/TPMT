<div class="absolute inset-0 bg-gradient-to-t from-navy-deep via-transparent to-navy-deep/60"></div>
</div>
<!-- Architectural Content Wrapper -->
<div class="relative z-10 w-full px-6 sm:px-8 lg:px-12 xl:px-16 2xl:px-20 py-12 lg:py-16 flex flex-col justify-between">
<!-- Top Eyebrow Metadata Ribbon -->
<div class="flex flex-wrap items-center gap-3 mb-6">
<span class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-dark-slate rounded-full text-precision-teal font-label-caps text-xs sm:text-sm tracking-wider uppercase shadow-sm border border-cyber-blue/30 font-bold">
<span class="w-2.5 h-2.5 rounded-full bg-electric-cyan animate-pulse"></span>
  THIRUMUDIVAKKAM TOOLROOM • CHENNAI
</span>
</div>
<!-- Split Hero Architecture -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
<!-- Left: Core Hook -->
<div class="lg:col-span-8 space-y-6">
<h1 class="font-heading-gold text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl text-white tracking-tight font-bold">
  Advanced Tooling &amp; <br/>
<span class="text-transparent bg-clip-text bg-gradient-to-r from-electric-cyan via-precision-teal to-machined-gold">
  Precision Injection Mold
</span> Solutions.
</h1>
<p class="text-base sm:text-lg lg:text-xl text-slate-100 max-w-2xl leading-relaxed">
  Operating from our 1,500 sq. ft. precision facility in Thirumudivakkam, Chennai. Equipped with Makino VMC CNC centers, Wire EDM, and full CMM metrology for sub-micron tooling in mission-critical medical, electronics, and automotive applications.
</p>
<!-- Dual CTAs -->
<div class="flex flex-wrap items-center gap-4 pt-2">
<a class="btn-cyber-blue inline-flex items-center gap-2 px-6 sm:px-8 py-3.5 sm:py-4 text-base sm:text-lg font-bold rounded shadow-lg transition-all duration-200" href="/contact">
<span>Request Engineering Quote</span>
<span class="material-symbols-outlined text-[20px]">arrow_forward</span>
</a>
<a class="btn-cyber-outline inline-flex items-center gap-2 px-6 sm:px-8 py-3.5 sm:py-4 text-base sm:text-lg font-bold rounded shadow transition-colors" href="/capabilities">
<span class="material-symbols-outlined text-[20px]">precision_manufacturing</span>
<span>Explore Capabilities</span>
</a>
</div>
</div>
<!-- Right: Fast Verification Micro-Telemetry -->
<div class="lg:col-span-4 flex flex-col gap-4">
<div class="bg-dark-slate p-6 rounded-xl border border-rich-gold/30 shadow-xl space-y-3">
<div class="flex items-center justify-between font-label-caps text-xs sm:text-sm text-slate-300 font-bold uppercase tracking-wider pb-2 border-b border-rich-gold/20">
<span>FACILITY TELEMETRY</span>
<span class="text-emerald-400 font-extrabold flex items-center gap-1.5">
<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> ONLINE
</span>
</div>
<div class="divide-y divide-rich-gold/15">
<div class="py-2.5 flex justify-between items-center text-sm sm:text-base">
<span class="text-slate-300 font-medium">Toolroom Footprint</span>
<span class="font-data-mono text-white font-bold">1,500 SQ. FT.</span>
</div>
<div class="py-2.5 flex justify-between items-center text-sm sm:text-base">
<span class="text-slate-300 font-medium">Standard Tolerances</span>
<span class="font-data-mono text-electric-cyan font-extrabold">± 0.005 mm</span>
</div>
<div class="py-2.5 flex justify-between items-center text-sm sm:text-base">
<span class="text-slate-300 font-medium">High-Speed Spindles</span>
<span class="font-data-mono text-white font-bold">Makino VMC Series</span>
</div>
<div class="py-2.5 flex justify-between items-center text-sm sm:text-base">
<span class="text-slate-300 font-medium">CAD/CAM Integration</span>
<span class="font-data-mono text-machined-gold font-bold">UG NX / Moldflow</span>
</div>
</div>
</div>
</div>
</div>
<!-- High-Impact Stats Matrix -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-10 pt-8 bg-dark-slate/80 border border-rich-gold/25 rounded-xl p-6">
<div class="flex flex-col">
<span class="text-3xl sm:text-4xl lg:text-5xl text-white font-extrabold">15+</span>
<span class="text-xs sm:text-sm text-slate-200 font-bold uppercase mt-1">Years Industry Leadership</span>
<span class="text-xs sm:text-sm text-precision-teal font-semibold mt-0.5">Proven Tamil Nadu Hub</span>
</div>
<div class="flex flex-col">
<span class="text-3xl sm:text-4xl lg:text-5xl text-electric-cyan font-extrabold">D3</span>
<span class="text-xs sm:text-sm text-slate-200 font-bold uppercase mt-1">Design • Dev • Delivery</span>
<span class="text-xs sm:text-sm text-slate-300 font-semibold mt-0.5">End-to-End Methodology</span>
</div>
<div class="flex flex-col">
<span class="text-3xl sm:text-4xl lg:text-5xl text-machined-gold font-extrabold">±5μm</span>
<span class="text-xs sm:text-sm text-slate-200 font-bold uppercase mt-1">Makino VMC Precision</span>
<span class="text-xs sm:text-sm text-slate-300 font-semibold mt-0.5">Optical &amp; CMM Verified</span>
</div>
<div class="flex flex-col">
<span class="text-3xl sm:text-4xl lg:text-5xl text-emerald-400 font-extrabold">100%</span>
<span class="text-xs sm:text-sm text-slate-200 font-bold uppercase mt-1">Zero Defect &amp; On-Time</span>
<span class="text-xs sm:text-sm text-slate-300 font-semibold mt-0.5">Mission-Critical SLAs</span>
</div>
</div>
</div>
</section>

<!-- D3 METHODOLOGY ENGINE -->
<section class="w-full bg-navy-deep py-12 lg:py-16 text-white border-b border-rich-gold/20">
<div class="w-full px-6 sm:px-8 lg:px-12 xl:px-16 2xl:px-20">
<!-- Section Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
<div>
<div class="flex items-center gap-2 text-cyber-blue font-label-caps text-xs sm:text-sm uppercase tracking-wider mb-1 font-bold">
<span class="material-symbols-outlined text-[18px]">account_tree</span>
  Structured Engineering Framework
</div>
<h2 class="font-heading-gold text-2xl sm:text-3xl lg:text-4xl text-rich-gold font-bold">
  The D3 Execution Engine
</h2>
</div>
<p class="text-base sm:text-lg text-slate-200 max-w-md leading-relaxed">
  From native CAD concept to high-yield production, our unified 3-phase methodology eliminates mold rebuilds and accelerates industrialization.
</p>
</div>
<!-- 3 Phase Workflow Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
<!-- Step 1: Design -->
<div class="bg-dark-slate border border-rich-gold/30 text-slate-100 shadow-xl p-6 sm:p-7 rounded-xl hover:border-rich-gold transition-all flex flex-col justify-between group">
<div>
<div class="flex items-center justify-between mb-4">
<span class="font-data-mono text-xs sm:text-sm px-3 py-1 bg-navy-deep rounded text-cyber-blue font-bold border border-cyber-blue/30">
  PHASE 01
</span>
<span class="material-symbols-outlined text-precision-teal text-[32px] group-hover:scale-110 transition-transform">architecture</span>
</div>
<h3 class="font-heading-gold text-xl sm:text-2xl text-rich-gold font-bold mb-2">Design &amp; DFM</h3>
<p class="text-base sm:text-lg text-slate-100 mb-6 leading-relaxed">
  Comprehensive DFM analysis, 3D mold layout simulation, gate cooling optimization, and parting line feasibility check before steel cutting.
</p>
</div>
<div class="space-y-2 font-data-mono text-sm sm:text-base pt-4 bg-navy-deep/90 border border-rich-gold/20 p-4 rounded-lg">
<div class="flex items-center justify-between text-slate-200">
<span>Rheology Analysis</span>
<span class="text-emerald-400 font-bold">PASS</span>
</div>
<div class="flex items-center justify-between text-slate-200">
<span>Shrinkage Offset</span>
<span class="text-white font-bold">Calibrated</span>
</div>
<div class="flex items-center justify-between text-slate-200">
<span>CAD Platforms</span>
<span class="text-cyber-blue font-bold">Creo / Solidworks</span>
</div>
</div>
</div>
<!-- Step 2: Development & Testing -->
<div class="bg-dark-slate border border-rich-gold/30 text-slate-100 shadow-xl p-6 sm:p-7 rounded-xl hover:border-rich-gold transition-all flex flex-col justify-between group">
<div>
<div class="flex items-center justify-between mb-4">
<span class="font-data-mono text-xs sm:text-sm px-3 py-1 bg-navy-deep rounded text-cyber-blue font-bold border border-cyber-blue/30">
  PHASE 02
</span>
<span class="material-symbols-outlined text-machined-gold text-[32px] group-hover:scale-110 transition-transform">precision_manufacturing</span>
</div>
<h3 class="font-heading-gold text-xl sm:text-2xl text-rich-gold font-bold mb-2">Development &amp; Testing</h3>
<p class="text-base sm:text-lg text-slate-100 mb-6 leading-relaxed">
  Makino VMC high-speed machining, precision EDM, tool assembly, and initial T0-T1 mold sampling runs under strict process validation.
</p>
</div>
<div class="space-y-2 font-data-mono text-sm sm:text-base pt-4 bg-navy-deep/90 border border-rich-gold/20 p-4 rounded-lg">
<div class="flex items-center justify-between text-slate-200">
<span>EDM Spark Gap</span>
<span class="text-white font-bold">0.015 mm</span>
</div>
<div class="flex items-center justify-between text-slate-200">
<span>Tool Steel Standard</span>
<span class="text-machined-gold font-bold">H13 / Stavax ESR</span>
</div>
<div class="flex items-center justify-between text-slate-200">
<span>Sample Validation</span>
<span class="text-emerald-400 font-bold">T1 First Article</span>
</div>
</div>
</div>
<!-- Step 3: Delivery -->
<div class="bg-dark-slate border border-rich-gold/30 text-slate-100 shadow-xl p-6 sm:p-7 rounded-xl hover:border-rich-gold transition-all flex flex-col justify-between group">
<div>
<div class="flex items-center justify-between mb-4">
<span class="font-data-mono text-xs sm:text-sm px-3 py-1 bg-navy-deep rounded text-cyber-blue font-bold border border-cyber-blue/30">
  PHASE 03
</span>
<span class="material-symbols-outlined text-cyber-blue text-[32px] group-hover:scale-110 transition-transform">local_shipping</span>
</div>
<h3 class="font-heading-gold text-xl sm:text-2xl text-rich-gold font-bold mb-2">Delivery &amp; Handover</h3>
<p class="text-base sm:text-lg text-slate-100 mb-6 leading-relaxed">
  100% CMM dimensional inspection sign-off, full tool maintenance manual, hot-runner diagnostics, and on-site integration support.
</p>
</div>
<div class="space-y-2 font-data-mono text-sm sm:text-base pt-4 bg-navy-deep/90 border border-rich-gold/20 p-4 rounded-lg">
<div class="flex items-center justify-between text-slate-200">
<span>Metrology Audit</span>
<span class="text-emerald-400 font-bold">100% CMM</span>
</div>
<div class="flex items-center justify-between text-slate-200">
<span>Spare Insert Pack</span>
<span class="text-white font-bold">Included</span>
</div>
<div class="flex items-center justify-between text-slate-200">
<span>Tool Warranty</span>
<span class="text-cyber-blue font-bold">Up to 1M Shots</span>
</div>
</div>
</div>
</div>
</div>
</section>

<!-- CORE SPECIALIZATION BANNER: VERTICAL INSERT & CABLE OVERMOLDING -->
<section class="w-full bg-charcoal-blue text-slate-100 border-b border-rich-gold/20 py-12 lg:py-16">
<div class="w-full px-6 sm:px-8 lg:px-12 xl:px-16 2xl:px-20">
<div class="bg-dark-slate border border-rich-gold/30 rounded-2xl shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-12">
<!-- Image Area -->
<div class="lg:col-span-6 relative min-h-[380px] lg:min-h-full">
<div class="w-full h-full bg-cover bg-center min-h-[360px]" style="background-image: url('/images/vertical-insert-overmolding-hd.jpg')"></div>
<div class="absolute bottom-4 left-4 right-4 p-4 bg-navy-deep/90 backdrop-blur-md rounded-lg text-white flex items-center justify-between border border-rich-gold/20">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-precision-teal text-[24px]">biotech</span>
<span class="font-heading-gold text-sm sm:text-base font-bold">Medical Insert Mold &amp; Overmolded Cable Harnesses</span>
</div>
<span class="text-xs sm:text-sm bg-precision-teal text-navy-deep px-3 py-1 rounded font-extrabold">VERIFIED</span>
</div>
</div>
<!-- Text Details -->
<div class="lg:col-span-6 p-6 sm:p-8 lg:p-10 flex flex-col justify-between">
<div>
<div class="inline-flex items-center gap-2 px-3.5 py-1 bg-navy-deep rounded-full text-cyber-blue font-label-caps text-xs sm:text-sm mb-4 border border-cyber-blue/30 font-bold tracking-wider uppercase">
<span class="material-symbols-outlined text-[16px] text-precision-teal">hub</span>
  HIGH PRECISION CORE SPECIALIZATION
</div>
<h2 class="font-heading-gold text-2xl sm:text-3xl lg:text-4xl text-rich-gold font-bold mb-4 leading-tight">
  Vertical Insert Molding &amp; Precision Cable Overmolding
</h2>
<p class="text-base sm:text-lg text-slate-100 mb-6 leading-relaxed">
  We specialize in custom tooling for vertical rotary insert molding machines. Engineered for zero pin deflection, flawless seal-off geometry, and high-integrity strain relief overmolding for medical patient monitor cables and automotive sensory harnesses.
</p>
<!-- Specification Badges -->
<div class="grid grid-cols-2 gap-4 mb-6">
<div class="p-4 bg-navy-deep/90 border border-rich-gold/20 rounded-lg">
<span class="text-xs sm:text-sm text-cyber-blue font-bold uppercase block">INSERT COMPATIBILITY</span>
<span class="text-base sm:text-lg font-bold text-white mt-1 block">Brass, SS316, Copper &amp; PCB</span>
</div>
<div class="p-4 bg-navy-deep/90 border border-rich-gold/20 rounded-lg">
<span class="text-xs sm:text-sm text-cyber-blue font-bold uppercase block">OVERMOLD RESINS</span>
<span class="text-base sm:text-lg font-bold text-white mt-1 block">TPU, TPE, PVC, PBT, PA66</span>
</div>
<div class="p-4 bg-navy-deep/90 border border-rich-gold/20 rounded-lg">
<span class="text-xs sm:text-sm text-cyber-blue font-bold uppercase block">SEAL-OFF SHUTOFF</span>
<span class="text-base sm:text-lg font-bold text-white mt-1 block">±0.003 mm Tolerance</span>
</div>
<div class="p-4 bg-navy-deep/90 border border-rich-gold/20 rounded-lg">
<span class="text-xs sm:text-sm text-cyber-blue font-bold uppercase block">APPLICATIONS</span>
<span class="text-base sm:text-lg font-bold text-white mt-1 block">ECG Leads, Sensor Plugs</span>
</div>
</div>
</div>
<div class="flex items-center gap-4">
<a class="inline-flex items-center gap-2 px-6 py-3 bg-navy-deep hover:bg-navy-surface text-white text-base sm:text-lg font-bold rounded shadow border border-rich-gold/30 transition-colors" href="/services">
<span>View Insert Tooling Specs</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
<span class="font-data-mono text-xs sm:text-sm text-slate-300 font-semibold">CYCLE TIME OPTIMIZED</span>
</div>
</div>
</div>
</div>
</section>

<!-- CAPABILITIES SNAPSHOT MATRIX -->
<section class="w-full bg-navy-deep py-12 lg:py-16 text-white border-b border-rich-gold/20">
<div class="w-full px-6 sm:px-8 lg:px-12 xl:px-16 2xl:px-20">
<!-- Section Title -->
<div class="mb-8 text-center max-w-2xl mx-auto">
<span class="text-xs sm:text-sm text-cyber-blue uppercase tracking-widest font-bold block mb-1">
  TOOLROOM INFRASTRUCTURE
</span>
<h2 class="font-heading-gold text-2xl sm:text-3xl lg:text-4xl text-rich-gold font-bold mb-2">
  Precision Tooling &amp; Machining Snapshot
</h2>
<p class="text-base sm:text-lg text-slate-200 leading-relaxed">
  Advanced CNC machining centers, electrode milling, and optical grinding systems delivering aerospace &amp; medical-grade repeatability.
</p>
</div>
<!-- 4 Pillars Bento Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
<!-- Spec 1: High Speed CNC Milling -->
<div class="card-tech-gold p-6 rounded-xl shadow-lg flex flex-col justify-between">
<div>
<div class="w-12 h-12 rounded-lg bg-navy-deep border border-cyber-blue/30 flex items-center justify-center text-precision-teal mb-4">
<span class="material-symbols-outlined text-[28px]">precision_manufacturing</span>
</div>
<span class="text-xs sm:text-sm text-cyber-blue font-bold uppercase">CAPABILITY // 01</span>
<h3 class="font-heading-gold text-lg sm:text-xl text-rich-gold font-bold mt-1 mb-2">High-Speed CNC Milling</h3>
<p class="text-sm sm:text-base text-slate-100 leading-relaxed mb-4">
  Makino VMC high-rigidity spindles reaching 12,000 RPM for mirror cavity finishes and fine graphite electrode fabrication.
</p>
</div>
<div class="font-data-mono text-xs sm:text-sm text-slate-200 bg-navy-deep/90 border border-rich-gold/20 p-2.5 rounded flex justify-between">
<span>Accuracy</span>
<span class="text-white font-extrabold">± 0.003 mm</span>
</div>
</div>
<!-- Spec 2: Micro EDM & Wire Cut -->
<div class="card-tech-gold p-6 rounded-xl shadow-lg flex flex-col justify-between">
<div>
<div class="w-12 h-12 rounded-lg bg-navy-deep border border-rich-gold/30 flex items-center justify-center text-machined-gold mb-4">
<span class="material-symbols-outlined text-[28px]">electric_bolt</span>
</div>
<span class="text-xs sm:text-sm text-cyber-blue font-bold uppercase">CAPABILITY // 02</span>
<h3 class="font-heading-gold text-lg sm:text-xl text-rich-gold font-bold mt-1 mb-2">Wire EDM &amp; Spark</h3>
<p class="text-sm sm:text-base text-slate-100 leading-relaxed mb-4">
  Sub-micron spark erosion for deep ribs, fine gate pins, hardened core slides, and intricate medical micro-shutoffs.
</p>
</div>
<div class="font-data-mono text-xs sm:text-sm text-slate-200 bg-navy-deep/90 border border-rich-gold/20 p-2.5 rounded flex justify-between">
<span>Surface Finish</span>
<span class="text-white font-extrabold">Ra 0.2 μm</span>
</div>
</div>
<!-- Spec 3: Surface & Cylindrical Grinding -->
<div class="card-tech-gold p-6 rounded-xl shadow-lg flex flex-col justify-between">
<div>
<div class="w-12 h-12 rounded-lg bg-navy-deep border border-cyber-blue/30 flex items-center justify-center text-precision-teal mb-4">
<span class="material-symbols-outlined text-[28px]">rotate_right</span>
</div>
<span class="text-xs sm:text-sm text-cyber-blue font-bold uppercase">CAPABILITY // 03</span>
<h3 class="font-heading-gold text-lg sm:text-xl text-rich-gold font-bold mt-1 mb-2">Ultra Precision Grinding</h3>
<p class="text-sm sm:text-base text-slate-100 leading-relaxed mb-4">
