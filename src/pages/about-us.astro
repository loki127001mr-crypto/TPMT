      </div>
      <span class="font-data-mono text-label-caps text-cyber-blue bg-dark-slate border border-cyber-blue/30 px-3 py-1.5 rounded self-start md:self-end font-semibold">
        RIGID CALIBRATION CYCLE • ZERO DRIFT
      </span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter-desktop">
      <!-- Machine 1: Makino VMC -->
      <div class="card-tech-gold rounded-xl p-space-lg shadow-xl flex flex-col justify-between hover:border-rich-gold transition-all">
        <div class="flex flex-col gap-space-md">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 bg-cyber-blue text-navy-deep font-label-caps text-label-caps rounded font-bold">1x MACHINE DEPLOYED</span>
            <span class="font-data-mono text-label-caps text-rich-gold font-semibold">ASSET ID: MKN-VMC-01</span>
          </div>
          <div>
            <h3 class="font-heading-gold text-headline-sm text-rich-gold font-bold">Makino VMC Machine</h3>
            <p class="font-label-caps text-label-caps text-cyber-blue mt-1 font-semibold">High-Precision CNC Machining</p>
          </div>
          <p class="font-body-md text-body-md text-soft-gray/85 leading-relaxed">
            Engineered for extreme dimensional fidelity, complex 3D mold core and cavity contours, high-surface-finish electrode manufacture, and hardened tool-steel cutting.
          </p>
          <div class="bg-navy-deep/80 p-space-md rounded border border-rich-gold/20 space-y-space-xs font-body-sm text-body-sm">
            <div class="flex justify-between font-data-mono text-label-caps">
              <span class="text-soft-gray/70">Primary Domain</span>
              <span class="font-bold text-white">Plastic Injection Molds</span>
            </div>
            <div class="flex justify-between font-data-mono text-label-caps">
              <span class="text-soft-gray/70">Tolerance Class</span>
              <span class="text-cyber-blue font-bold">± 0.005 mm</span>
            </div>
            <div class="flex justify-between font-data-mono text-label-caps">
              <span class="text-soft-gray/70">Spindle Stability</span>
              <span class="text-white font-semibold">Continuous Run Ready</span>
            </div>
          </div>
        </div>
        <div class="mt-space-lg flex items-center gap-space-xs text-emerald-400 font-label-caps text-label-caps font-semibold">
          <span class="material-symbols-outlined text-[16px]">check_circle</span>
          <span>Calibrated &amp; Operating in Production</span>
        </div>
      </div>

      <!-- Machine 2: Conventional Milling -->
      <div class="card-tech-gold rounded-xl p-space-lg shadow-xl flex flex-col justify-between hover:border-rich-gold transition-all">
        <div class="flex flex-col gap-space-md">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 bg-dark-slate border border-cyber-blue/40 text-cyber-blue font-label-caps text-label-caps rounded font-bold">1x MACHINE DEPLOYED</span>
            <span class="font-data-mono text-label-caps text-rich-gold font-semibold">ASSET ID: MIL-CONV-02</span>
          </div>
