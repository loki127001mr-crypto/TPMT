<!-- Top Technical Breadcrumb & Plant Coordinates -->
<section class="w-full bg-navy-deep text-slate-200 py-3 px-6 lg:px-14 border-b border-rich-gold/20">
  <div class="w-full flex flex-wrap items-center justify-between gap-3 font-data-mono text-xs sm:text-sm">
    <div class="flex items-center gap-2 text-slate-300">
      <span class="text-cyber-blue font-bold">PLANT ID: CHN-TMV-01</span>
      <span>/</span>
      <span>FACILITY PROFILE &amp; GOVERNANCE</span>
      <span>/</span>
      <span class="text-rich-gold font-bold">ABOUT US</span>
    </div>
    <div class="flex items-center gap-4 text-slate-300 font-medium">
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block shadow-[0_0_8px_#10B981]"></span> FACILITY STATUS: ACTIVE</span>
