      <!-- Executive Board Umbrella Header -->
      <div class="w-full max-w-2xl bg-dark-slate text-white text-center py-space-md px-space-xl rounded-xl shadow-md border border-rich-gold/40 relative">
        <div class="flex items-center justify-center gap-2 mb-1">
          <span class="w-2 h-2 rounded-full bg-cyber-blue animate-pulse shadow-[0_0_8px_#00E5FF]"></span>
          <span class="font-label-caps text-label-caps text-cyber-blue font-bold tracking-widest uppercase">Executive Governance Framework</span>
