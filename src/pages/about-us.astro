    <div class="lg:col-span-8 flex flex-col gap-space-md">
      <div class="inline-flex items-center gap-space-xs font-label-caps text-label-caps text-cyber-blue font-semibold uppercase tracking-widest">
        <span class="material-symbols-outlined text-[16px] text-cyber-blue">precision_manufacturing</span>
        Corporate Profile &amp; Governance
      </div>
      <h1 class="font-heading-gold text-display-hero lg:text-[50px] xl:text-[56px] text-rich-gold tracking-tight font-bold">
        Engineering Excellence &amp; Leadership Profile
      </h1>
      <p class="font-body-lg text-body-lg text-soft-gray/90 max-w-3xl leading-relaxed">
        Emerging high-precision tooling and manufacturing powerhouse based in Thirumudivakkam, Chennai. We engineer injection molds, rubber dies, and vertical insert molding systems built to sub-micron tolerances for mission-critical automotive, medical, and electronic assemblies.
      </p>
    </div>
    <div class="lg:col-span-4 flex flex-col gap-space-sm bg-dark-slate p-space-lg rounded-xl border border-rich-gold/30 shadow-xl">
      <div class="flex items-center justify-between pb-space-xs border-b border-rich-gold/15">
        <span class="font-label-caps text-label-caps text-soft-gray/70 uppercase">Operational Footprint</span>
        <span class="font-data-mono text-label-caps text-cyber-blue bg-navy-deep px-2.5 py-0.5 rounded border border-cyber-blue/30 font-bold">CHENNAI HUB</span>
      </div>
      <div class="grid grid-cols-2 gap-space-md pt-space-xs">
        <div>
          <div class="font-metric-val text-metric-val text-white font-bold">1,750</div>
          <div class="font-label-caps text-label-caps text-soft-gray/70">TOTAL SQ. FT. FACILITY</div>
        </div>
        <div>
          <div class="font-metric-val text-metric-val text-cyber-blue font-bold">30+</div>
          <div class="font-label-caps text-label-caps text-soft-gray/70">COMBINED EXP. (YRS)</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 2: Facility & Infrastructure Architecture (Bento Grid) -->
<section class="w-full bg-navy-deep py-space-3xl px-6 lg:px-14 border-b border-rich-gold/20">
  <div class="w-full flex flex-col gap-space-2xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
      <div>
        <span class="font-label-caps text-label-caps text-cyber-blue font-semibold uppercase tracking-wider block mb-space-xs">01 // Physical Assets</span>
        <h2 class="font-heading-gold text-headline-lg text-rich-gold font-bold">Integrated Toolroom &amp; Technical Office</h2>
      </div>
      <p class="font-body-md text-body-md text-soft-gray/80 max-w-md">
        Built for segregated clean processing: heavy micro-machining is decoupled from administrative client engineering zones.
      </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-desktop">
      <!-- Main Shop Floor Card (8 Col) -->
      <div class="lg:col-span-8 bg-dark-slate rounded-xl p-space-xl flex flex-col justify-between border border-rich-gold/30 shadow-xl relative overflow-hidden">
        <div class="flex flex-col gap-space-md">
          <div class="flex flex-wrap items-center justify-between gap-space-sm">
            <span class="font-label-caps text-label-caps text-cyber-blue px-3 py-1 bg-navy-deep rounded border border-cyber-blue/30 font-bold">
              CORE PRODUCTION FLOOR • 1,500 SQ. FT.
            </span>
            <span class="font-data-mono text-label-caps text-rich-gold">ZONE: SHOPFLOOR-HEAVY</span>
          </div>
          <h3 class="font-heading-gold text-headline-sm text-rich-gold font-bold">
            Precision Mold Manufacturing &amp; High-Tolerance Machining
          </h3>
          <p class="font-body-md text-body-md text-soft-gray/85 leading-relaxed">
            Engineered with climate-controlled zones, rigid anti-vibration machine footings, and high-capacity electrical distribution to run simultaneous continuous 3-axis VMC roughing and ultra-fine finishing routines.
          </p>
          <!-- Inline Micro Metric Specs: Clear High Contrast -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-space-md mt-space-sm">
            <div class="bg-navy-deep/80 p-space-md rounded border border-rich-gold/25">
              <div class="font-headline-sm text-headline-sm text-cyber-blue font-bold">±0.005<span class="text-label-caps font-data-mono">mm</span></div>
              <div class="font-label-caps text-label-caps text-rich-gold font-semibold mt-1">TOLERANCE CAPABILITY</div>
            </div>
            <div class="bg-navy-deep/80 p-space-md rounded border border-rich-gold/25">
              <div class="font-headline-sm text-headline-sm text-white font-bold">QUALITY</div>
              <div class="font-label-caps text-label-caps text-rich-gold font-semibold mt-1">AUDITED STANDARDS</div>
            </div>
            <div class="bg-navy-deep/80 p-space-md rounded border border-rich-gold/25">
              <div class="font-headline-sm text-headline-sm text-cyber-blue font-bold">3-AXIS</div>
              <div class="font-label-caps text-label-caps text-rich-gold font-semibold mt-1">HIGH PRECISION CNC</div>
            </div>
          </div>
        </div>
        <div class="mt-space-lg pt-space-md border-t border-rich-gold/15 flex items-center justify-between text-soft-gray font-data-mono text-label-caps">
          <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[16px] text-cyber-blue">verified</span> Dedicated Inspection Bench</span>
          <span class="text-soft-gray/80">THIRUMUDIVAKKAM INDUSTRIAL ESTATE</span>
        </div>
      </div>

      <!-- Administrative Office Card (4 Col) -->
      <div class="lg:col-span-4 bg-charcoal-blue text-soft-gray rounded-xl p-space-xl flex flex-col justify-between border border-rich-gold/30 shadow-xl relative">
        <div class="flex flex-col gap-space-md">
          <div class="flex items-center justify-between">
            <span class="font-label-caps text-label-caps text-rich-gold px-2.5 py-1 bg-dark-slate border border-rich-gold/30 rounded font-bold">
              FRONT OFFICE • 250 SQ. FT.
            </span>
            <span class="material-symbols-outlined text-cyber-blue">corporate_fare</span>
          </div>
