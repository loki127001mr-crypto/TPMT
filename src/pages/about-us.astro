        <div class="mt-space-lg bg-dark-slate p-space-md rounded border border-cyber-blue/30 space-y-space-xs">
          <div class="font-label-caps text-label-caps text-cyber-blue uppercase tracking-wide font-semibold">Secure Communications</div>
          <p class="font-body-sm text-body-sm text-white font-medium">Tripowermouldtec@gmail.com</p>
          <p class="font-data-mono text-label-caps text-rich-gold font-bold">+91 9176729970 / +91 7904355971</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 3: Machinery & Equipment Specification Matrix -->
<section class="w-full bg-charcoal-blue py-space-3xl px-6 lg:px-14 border-b border-rich-gold/20">
