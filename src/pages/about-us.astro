        <span class="font-data-mono text-xs sm:text-sm text-cyber-blue bg-navy-deep px-3 py-1 rounded border border-cyber-blue/30 font-bold">CHENNAI HUB</span>
      </div>
      <div class="grid grid-cols-2 gap-4 pt-2">
        <div>
          <div class="text-3xl sm:text-4xl text-white font-extrabold">1,750</div>
          <div class="text-xs sm:text-sm text-slate-200 font-semibold uppercase mt-1">TOTAL SQ. FT. FACILITY</div>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl text-cyber-blue font-extrabold">30+</div>
