                    <span class="material-symbols-outlined text-[20px]">account_balance</span>
                  </div>
                </div>

                <!-- Competencies Tags -->
                <div class="flex flex-wrap gap-1.5 pt-1">
                  <span class="px-2 py-0.5 bg-navy-deep text-soft-gray rounded text-label-caps font-data-mono border border-rich-gold/20">Die Casting</span>
                  <span class="px-2 py-0.5 bg-navy-deep text-soft-gray rounded text-label-caps font-data-mono border border-rich-gold/20">SCM Operations</span>
                  <span class="px-2 py-0.5 bg-navy-deep text-soft-gray rounded text-label-caps font-data-mono border border-rich-gold/20">Commercial Quoting</span>
                </div>

                <!-- Bio & Description -->
                <p class="font-body-sm text-body-sm text-soft-gray/85 leading-relaxed">
