---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us | Tripower Mold Tech - Precision Engineering Excellence" description="Learn about Tripower Mold Tech, our history, precision toolroom in Thirumudivakkam, Chennai, leadership team, and precision engineering philosophy." currentPage="about-us">
<!-- Top Technical Breadcrumb & Plant Coordinates -->
<section class="w-full bg-navy-deep text-soft-gray py-space-sm px-6 lg:px-14 border-b border-rich-gold/20">
  <div class="w-full flex flex-wrap items-center justify-between gap-space-sm font-data-mono text-label-caps">
    <div class="flex items-center gap-space-sm text-soft-gray/70">
      <span class="text-cyber-blue font-bold">PLANT ID: CHN-TMV-01</span>
      <span>/</span>
      <span>FACILITY PROFILE &amp; GOVERNANCE</span>
      <span>/</span>
      <span class="text-rich-gold font-semibold">ABOUT US</span>
    </div>
    <div class="flex items-center gap-space-lg text-soft-gray/70">
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400 inline-block shadow-[0_0_8px_#10B981]"></span> FACILITY STATUS: ACTIVE</span>
      <span class="text-rich-gold">COORDINATES: 12.9832° N, 80.0837° E</span>
    </div>
  </div>
</section>

<!-- Section 1: Editorial Header Banner -->
<section class="w-full bg-charcoal-blue py-space-3xl px-6 lg:px-14 relative overflow-hidden border-b border-rich-gold/20">
  <div class="absolute -right-24 -top-24 w-96 h-96 bg-cyber-blue/10 rounded-full blur-3xl pointer-events-none"></div>
