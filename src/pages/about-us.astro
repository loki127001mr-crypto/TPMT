            </div>
            <div class="bg-navy-deep/90 p-4 rounded-lg border border-rich-gold/25">
              <div class="text-2xl sm:text-3xl text-white font-extrabold">QUALITY</div>
              <div class="text-xs sm:text-sm text-rich-gold font-bold uppercase mt-1">AUDITED STANDARDS</div>
            </div>
            <div class="bg-navy-deep/90 p-4 rounded-lg border border-rich-gold/25">
              <div class="text-2xl sm:text-3xl text-cyber-blue font-extrabold">3-AXIS</div>
              <div class="text-xs sm:text-sm text-rich-gold font-bold uppercase mt-1">HIGH PRECISION CNC</div>
