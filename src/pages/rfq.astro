<div class="absolute inset-0 bg-gradient-to-t from-navy-deep via-transparent to-navy-deep/60"></div>
</div>
<!-- Architectural Content Wrapper -->
<div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 py-space-3xl flex flex-col justify-between">
