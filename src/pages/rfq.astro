<div class="flex flex-wrap items-center gap-space-md mb-space-xl">
<span class="inline-flex items-center gap-1.5 px-3 py-1 bg-navy-surface rounded-full text-precision-teal font-label-caps text-label-caps tracking-wider uppercase shadow-sm">
<span class="w-2 h-2 rounded-full bg-electric-cyan animate-pulse"></span>
          THIRUMUDIVAKKAM TOOLROOM • CHENNAI
        </span>
<span class="hidden sm:inline-block w-px h-4 bg-slate-700"></span>
<span class="text-slate-400 font-data-mono text-body-sm flex items-center gap-1">
<span class="material-symbols-outlined text-[15px] text-machined-gold">verified</span>
          ISO 9001:2015 AUDITED STANDARDS
        </span>
</div>
<!-- Split Hero Architecture -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-desktop items-center">
<!-- Left: Core Hook -->
<div class="lg:col-span-8 space-y-space-lg">
<h1 class="font-display-hero text-display-hero text-white tracking-tight">
            Advanced Tooling &amp; <br/>
<span class="text-transparent bg-clip-text bg-gradient-to-r from-electric-cyan via-precision-teal to-machined-gold">
              Precision Injection Mold
            </span> Solutions.
          </h1>
<p class="font-body-lg text-body-lg text-slate-400 max-w-2xl leading-relaxed">
            Operating from our 1,500 sq. ft. precision facility in Thirumudivakkam, Chennai. Equipped with Makino VMC CNC centers, Wire EDM, and full CMM metrology for sub-micron tooling in mission-critical medical, electronics, and automotive applications.
          </p>
<!-- Dual CTAs -->
<div class="flex flex-wrap items-center gap-space-md pt-space-sm">
<a class="inline-flex items-center gap-space-sm px-space-xl py-space-md bg-precision-teal hover:bg-electric-cyan text-primary-container font-headline-sm text-body-md font-bold rounded shadow-lg hover:shadow-cyan-500/20 transition-all duration-200" href="/rfq">
<span>Request Engineering Quote</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
<a class="inline-flex items-center gap-space-sm px-space-xl py-space-md bg-navy-surface hover:bg-navy-card text-white font-headline-sm text-body-md font-medium rounded shadow transition-colors" href="/capabilities">
<span class="material-symbols-outlined text-[18px] text-precision-teal">precision_manufacturing</span>
<span>Explore Capabilities</span>
</a>
</div>
</div>
<!-- Right: Fast Verification Micro-Telemetry -->
<div class="lg:col-span-4 flex flex-col gap-space-md">
<div class="bg-navy-surface/90 backdrop-blur-md p-space-lg rounded shadow-xl space-y-space-sm">
<div class="flex items-center justify-between font-label-caps text-label-caps text-slate-400">
<span>FACILITY TELEMETRY</span>
<span class="text-status-success font-semibold flex items-center gap-1">
<span class="w-1.5 h-1.5 rounded-full bg-status-success"></span> ONLINE
              </span>
</div>
<div class="divide-y divide-slate-800/80">
<div class="py-space-sm flex justify-between items-center">
