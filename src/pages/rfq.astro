<span class="font-headline-sm text-body-md font-semibold text-slate-900">±0.003 mm Tolerance</span>
</div>
<div class="p-space-md bg-surface-container-low rounded">
<span class="font-label-caps text-label-caps text-secondary block">APPLICATIONS</span>
<span class="font-headline-sm text-body-md font-semibold text-slate-900">ECG Leads, Sensor Plugs</span>
</div>
</div>
</div>
<div class="flex items-center gap-space-md">
<a class="inline-flex items-center gap-space-xs px-space-lg py-space-sm bg-navy-surface hover:bg-navy-card text-white font-headline-sm text-body-sm font-semibold rounded shadow transition-colors" href="/services">
<span>View Insert Tooling Specs</span>
<span class="material-symbols-outlined text-[16px]">arrow_forward</span>
</a>
<span class="font-data-mono text-label-caps text-slate-500">CYCLE TIME OPTIMIZED</span>
</div>
</div>
</div>
</div>
</section>
<!-- CAPABILITIES SNAPSHOT MATRIX -->
<section class="w-full bg-surface py-space-3xl text-on-surface">
<div class="max-w-7xl mx-auto px-6 lg:px-12">
<!-- Section Title -->
<div class="mb-space-2xl text-center max-w-2xl mx-auto">
<span class="font-label-caps text-label-caps text-secondary uppercase tracking-widest block mb-space-xs">
          TOOLROOM INFRASTRUCTURE
