<div class="bg-surface-container-lowest p-space-xl rounded shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group">
<div>
<div class="flex items-center justify-between mb-space-lg">
<span class="font-data-mono text-label-caps px-2.5 py-1 bg-surface-container-high rounded text-secondary font-bold">
                PHASE 03
              </span>
<span class="material-symbols-outlined text-secondary text-[28px] group-hover:scale-110 transition-transform">local_shipping</span>
</div>
<h3 class="font-headline-md text-headline-md text-slate-900 mb-space-sm">Delivery &amp; Handover</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-space-lg leading-relaxed">
              100% CMM dimensional inspection sign-off, full tool maintenance manual, hot-runner diagnostics, and on-site integration support.
            </p>
</div>
<div class="space-y-space-xs font-data-mono text-body-sm pt-space-md bg-surface-container-low p-space-md rounded">
<div class="flex items-center justify-between text-slate-700">
<span>Metrology Audit</span>
<span class="text-status-success font-semibold">100% CMM</span>
</div>
<div class="flex items-center justify-between text-slate-700">
<span>Spare Insert Pack</span>
<span class="text-slate-900 font-semibold">Included</span>
</div>
<div class="flex items-center justify-between text-slate-700">
<span>Tool Warranty</span>
<span class="text-secondary font-semibold">Up to 1M Shots</span>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- CORE SPECIALIZATION BANNER: VERTICAL INSERT & CABLE OVERMOLDING -->
<section class="w-full bg-slate-100 py-space-3xl text-on-surface">
<div class="max-w-7xl mx-auto px-6 lg:px-12">
<div class="bg-surface-container-lowest rounded-xl shadow-lg overflow-hidden grid grid-cols-1 lg:grid-cols-12">
<!-- Image Area -->
<div class="lg:col-span-6 relative min-h-[380px] lg:min-h-full">
<div class="w-full h-full bg-cover bg-center min-h-[360px]" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAFk_q6Yy_AZkd4XM2fBwDzfj0Er9pI9zMmNFbjPwYaRvmWkyRSycNiZJmzpAnjuIOn9tb1-5tc8w7OCLe2rcqTUYDjc6jJeOcFyYsVXlkKW6VazrQeCihYVrO_qanFAIWCwulq48f0z8Q64_UW-UBbMO6Y_vwfQtgipoKGQ1JXoEi38GMX8kbhhhAWRxyBaNPBRRY5f5nESCWpU15iyBoE4LzHeOBUKNS-RKtFxj3R')"></div>
<div class="absolute bottom-4 left-4 right-4 p-space-sm bg-navy-deep/85 backdrop-blur-md rounded text-white flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-precision-teal text-[20px]">biotech</span>
<span class="font-headline-sm text-body-sm font-semibold">Medical Insert Mold &amp; Overmolded Cable Harnesses</span>
</div>
<span class="font-label-caps text-label-caps bg-precision-teal text-primary-container px-2 py-0.5 rounded font-bold">VERIFIED</span>
</div>
</div>
<!-- Text Details -->
<div class="lg:col-span-6 p-space-xl lg:p-space-2xl flex flex-col justify-between">
<div>
<div class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container rounded-full text-secondary font-label-caps text-label-caps mb-space-md">
<span class="material-symbols-outlined text-[15px] text-precision-teal">hub</span>
              HIGH PRECISION CORE SPECIALIZATION
            </div>
<h2 class="font-headline-lg text-headline-lg text-slate-900 mb-space-md leading-tight">
              Vertical Insert Molding &amp; Precision Cable Overmolding
            </h2>
<p class="font-body-md text-body-md text-on-surface-variant mb-space-lg leading-relaxed">
              We specialize in custom tooling for vertical rotary insert molding machines. Engineered for zero pin deflection, flawless seal-off geometry, and high-integrity strain relief overmolding for medical patient monitor cables and automotive sensory harnesses.
            </p>
<!-- Specification Badges -->
<div class="grid grid-cols-2 gap-space-md mb-space-xl">
<div class="p-space-md bg-surface-container-low rounded">
<span class="font-label-caps text-label-caps text-secondary block">INSERT COMPATIBILITY</span>
<span class="font-headline-sm text-body-md font-semibold text-slate-900">Brass, SS316, Copper &amp; PCB</span>
</div>
<div class="p-space-md bg-surface-container-low rounded">
<span class="font-label-caps text-label-caps text-secondary block">OVERMOLD RESINS</span>
